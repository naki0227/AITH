{
    "unit_id": "chinese_basic",
    "unit_title": "中国語入門",
    "order": 1,
    "chapters": [
        {
            "title": "1. 発音",
            "sections": [
                {
                    "title": "ピンインと四声",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "中国語は「声調言語」。同じ発音でも音の高低パターン（四声）が違えば全く別の意味になります。"
                        },
                        {
                            "type": "point",
                            "title": "四声（声調）",
                            "content": "**第一声** (ˉ): 高く平らに → mā（お母さん）\\n**第二声** (ˊ): 急激に上がる → má（麻）\\n**第三声** (ˇ): 低く抑える → mǎ（馬）\\n**第四声** (ˋ): 急激に下がる → mà（叱る）"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 四声",
                            "problem": "「ma」を第三声で発音すると何を意味するか。",
                            "solution_steps": [
                                "mǎ = **馬（うま）**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "第一声の特徴は？",
                                    "a": "高く平らに発音"
                                },
                                {
                                    "q": "「妈」の発音は？",
                                    "a": "mā（第一声）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 基本文法",
            "sections": [
                {
                    "title": "語順とあいさつ",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "基本語順（SVO）",
                            "content": "英語と同様、主語＋動詞＋目的語の順。\\n**我爱你** (Wǒ ài nǐ) = I love you"
                        },
                        {
                            "type": "point",
                            "title": "基本あいさつ",
                            "content": "**你好** (Nǐ hǎo) = こんにちは\\n**谢谢** (Xièxie) = ありがとう\\n**再见** (Zàijiàn) = さようなら"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: あいさつ",
                            "problem": "「ありがとう」を中国語で言うと？",
                            "solution_steps": [
                                "答え: **谢谢 (Xièxie)**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "「こんにちは」の中国語は？",
                                    "a": "你好 (Nǐ hǎo)"
                                },
                                {
                                    "q": "中国語の基本語順は？",
                                    "a": "SVO（主語+動詞+目的語）"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}