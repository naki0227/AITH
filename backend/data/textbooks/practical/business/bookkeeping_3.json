    "chapters": [
        {
            "title": "1. 簿記の基礎",
            "sections": [
                {
                    "title": "仕訳",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "簿記とは、お金の出入りを記録するルールです。「借方（左）」と「貸方（右）」に分けて記録します。"
                        },
                        {
                            "type": "point",
                            "title": "ホームポジション",
                            "content": "- 資産: 増えたら左 (借方)\n- 負債: 増えたら右 (貸方)\n- 純資産: 増えたら右 (貸方)\n- 収益: 発生したら右 (貸方)\n- 費用: 発生したら左 (借方)"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 現金の増加 (Level 1)",
                            "problem": "商品100円を売り上げ、代金は現金で受け取った。仕訳を行え。",
                            "solution_steps": [
                                "現金（資産）が増えたので借方（左）に現金100。",
                                "売上（収益）が発生したので貸方（右）に売上100。",
                                "(借) 現金 100 / (貸) 売上 100"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}