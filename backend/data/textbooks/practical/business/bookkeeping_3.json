{
    "unit_id": "practical_bookkeeping_3",
    "unit_title": "日商簿記3級",
    "order": 3,
    "chapters": [
        {
            "title": "1. 簿記の基礎",
            "sections": [
                {
                    "title": "仕訳の基本",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "簿記とは、お金の出入りを記録するルールです。「借方（左）」と「貸方（右）」に分けて記録します。必ず左右が一致するのがポイント！"
                        },
                        {
                            "type": "point",
                            "title": "ホームポジション",
                            "content": "**資産**: 増えたら借方（左）\\n**負債**: 増えたら貸方（右）\\n**純資産**: 増えたら貸方（右）\\n**収益**: 発生したら貸方（右）\\n**費用**: 発生したら借方（左）"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 現金売上",
                            "problem": "商品100円を売り上げ、代金は現金で受け取った。仕訳を行え。",
                            "solution_steps": [
                                "現金（資産）が増加 → 借方",
                                "売上（収益）が発生 → 貸方",
                                "**(借) 現金 100 / (貸) 売上 100**"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 掛け売上",
                            "problem": "商品500円を売り上げ、代金は後日受け取ることにした。",
                            "solution_steps": [
                                "売掛金（資産）が増加 → 借方",
                                "売上（収益）が発生 → 貸方",
                                "**(借) 売掛金 500 / (貸) 売上 500**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "現金で商品300円を仕入れた仕訳は？",
                                    "a": "(借)仕入 300 (貸)現金 300"
                                },
                                {
                                    "q": "銀行から1000円借りた仕訳は？",
                                    "a": "(借)現金 1000 (貸)借入金 1000"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 勘定科目",
            "sections": [
                {
                    "title": "主要な勘定科目",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "資産の勘定科目",
                            "content": "**現金**: お金そのもの\\n**売掛金**: まだ受け取っていない代金\\n**商品**: 販売目的で保有\\n**備品**: 事務机、パソコンなど"
                        },
                        {
                            "type": "point",
                            "title": "負債・純資産の勘定科目",
                            "content": "**買掛金**: まだ払っていない代金\\n**借入金**: 銀行などからの借金\\n**資本金**: 元手"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 買掛金の支払い",
                            "problem": "買掛金200円を現金で支払った。",
                            "solution_steps": [
                                "買掛金（負債）が減少 → 借方",
                                "現金（資産）が減少 → 貸方",
                                "**(借) 買掛金 200 / (貸) 現金 200**"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "3. 決算",
            "sections": [
                {
                    "title": "試算表と財務諸表",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "決算の流れ",
                            "content": "1. 試算表の作成\\n2. 決算整理仕訳\\n3. 精算表の作成\\n4. 貸借対照表・損益計算書の作成"
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "資産・負債・純資産をまとめた表は？",
                                    "a": "貸借対照表（B/S）"
                                },
                                {
                                    "q": "収益・費用をまとめた表は？",
                                    "a": "損益計算書（P/L）"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
