{
    "unit_id": "anatomy_basic",
    "unit_title": "解剖学基礎",
    "order": 3,
    "chapters": [
        {
            "title": "1. 人体の構造",
            "sections": [
                {
                    "title": "骨格系",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "人体は約200個の骨からなる骨格によって支えられています。骨格は体を支え、臓器を守り、運動を可能にします。"
                        },
                        {
                            "type": "point",
                            "title": "骨の分類",
                            "content": "**頭蓋骨**: 脳を守る\\n**脊柱**: 頸椎7・胸椎12・腰椎5・仙骨・尾骨\\n**肋骨**: 12対、胸腔を守る\\n**四肢骨**: 上肢・下肢"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 脊柱",
                            "problem": "頸椎は何個あるか。",
                            "solution_steps": [
                                "答え: **7個**（キリンも人間も同じ）"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 臓器系統",
            "sections": [
                {
                    "title": "消化器系",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "消化管の構造",
                            "content": "口腔→咽頭→食道→**胃**→**小腸**（十二指腸・空腸・回腸）→**大腸**→肛門"
                        },
                        {
                            "type": "point",
                            "title": "消化腺",
                            "content": "**唾液腺**: 唾液（アミラーゼ）\\n**肝臓**: 胆汁を分泌\\n**膵臓**: 膵液（消化酵素）とインスリン"
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "胃の次に続く臓器は？",
                                    "a": "小腸（十二指腸）"
                                },
                                {
                                    "q": "インスリンを分泌する臓器は？",
                                    "a": "膵臓（すいぞう）"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "循環器系",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "心臓の構造",
                            "content": "4つの部屋: 左右の心房・心室\\n**右心系**: 全身→右心房→右心室→肺（肺循環）\\n**左心系**: 肺→左心房→左心室→全身（体循環）"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 血液循環",
                            "problem": "酸素を多く含む血液が流れるのはどちらか。①大動脈 ②大静脈",
                            "solution_steps": [
                                "大動脈は心臓から全身へ酸素を運ぶ",
                                "答え: **①大動脈**"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}