{
    "unit_id": "unit1_polynomials",
    "unit_title": "第1章 多項式",
    "order": 1,
    "chapters": [
        {
            "title": "1. 多項式の計算",
            "sections": [
                {
                    "title": "展開",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "中学3年生の数学では、式の計算がさらに発展します。まずは「展開」と「因数分解」という、式を変形する2つの技術を学びましょう。これらは高校数学の基礎となる重要な内容です。"
                        },
                        {
                            "type": "definition",
                            "term": "展開",
                            "definition": "単項式 × 多項式や、多項式 × 多項式の積を計算して、**単項式の和の形**に表すことを**展開**といいます。"
                        },
                        {
                            "type": "point",
                            "title": "分配法則",
                            "content": "展開の基本は分配法則です。\\n$$ a(b + c) = ab + ac $$\\n$$ (a + b)(c + d) = ac + ad + bc + bd $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 基本の展開",
                            "problem": "次の式を展開しなさい。\\n(1) $3(2x - 5)$\\n(2) $(x + 2)(x + 3)$",
                            "solution_steps": [
                                "(1) 分配法則を使います。",
                                "$3 \\times 2x + 3 \\times (-5) = 6x - 15$",
                                "(2) 4つの項の積を計算します。",
                                "$x \\times x + x \\times 3 + 2 \\times x + 2 \\times 3$",
                                "$= x^2 + 3x + 2x + 6 = x^2 + 5x + 6$"
                            ]
                        }
                    ]
                },
                {
                    "title": "乗法公式",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "展開を効率よく行うために、よく使うパターンを「乗法公式」として覚えましょう。これを覚えれば計算が速くなります。"
                        },
                        {
                            "type": "point",
                            "title": "乗法公式①②",
                            "content": "**公式①** $(x + a)(x + b) = x^2 + (a + b)x + ab$\\n\\n**公式②** $(x + a)^2 = x^2 + 2ax + a^2$（和の2乗）\\n\\n**公式③** $(x - a)^2 = x^2 - 2ax + a^2$（差の2乗）"
                        },
                        {
                            "type": "point",
                            "title": "乗法公式④",
                            "content": "**公式④** $(x + a)(x - a) = x^2 - a^2$（和と差の積）\\n\\nこれは「2乗の差」を作る公式で、非常に重要です。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 公式①を使う",
                            "problem": "$(x + 3)(x - 5)$ を展開しなさい。",
                            "solution_steps": [
                                "公式① $(x + a)(x + b) = x^2 + (a + b)x + ab$",
                                "$a = 3$, $b = -5$ として、",
                                "$x^2 + (3 + (-5))x + 3 \\times (-5)$",
                                "$= x^2 - 2x - 15$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 公式②③を使う",
                            "problem": "次の式を展開しなさい。\\n(1) $(x + 4)^2$\\n(2) $(x - 3)^2$",
                            "solution_steps": [
                                "(1) 公式② $a = 4$ として、",
                                "$x^2 + 2 \\times 4 \\times x + 4^2 = x^2 + 8x + 16$",
                                "(2) 公式③ $a = 3$ として、",
                                "$x^2 - 2 \\times 3 \\times x + 3^2 = x^2 - 6x + 9$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 公式④を使う",
                            "problem": "$(x + 7)(x - 7)$ を展開しなさい。",
                            "solution_steps": [
                                "公式④（和と差の積）を使います。",
                                "$x^2 - 7^2 = x^2 - 49$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: 数の計算への応用",
                            "problem": "$97 \\times 103$ を公式を使って計算しなさい。",
                            "solution_steps": [
                                "$97 = 100 - 3$, $103 = 100 + 3$ と考えます。",
                                "$(100 - 3)(100 + 3) = 100^2 - 3^2$",
                                "$= 10000 - 9 = 9991$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$(x + 2)(x + 5)$",
                                    "a": "$x^2 + 7x + 10$"
                                },
                                {
                                    "q": "$(x - 4)^2$",
                                    "a": "$x^2 - 8x + 16$"
                                },
                                {
                                    "q": "$(x + 6)(x - 6)$",
                                    "a": "$x^2 - 36$"
                                },
                                {
                                    "q": "$99^2$（公式を使って）",
                                    "a": "$9801$（$(100-1)^2 = 10000 - 200 + 1$）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 因数分解",
            "sections": [
                {
                    "title": "因数分解の基礎",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "「因数分解」は展開の逆の操作です。式を積の形に変形することで、方程式を解いたり、式の値を求めたりするのに役立ちます。"
                        },
                        {
                            "type": "definition",
                            "term": "因数分解",
                            "definition": "多項式を、いくつかの**因数**（単項式や多項式）の**積**として表すことを**因数分解**といいます。"
                        },
                        {
                            "type": "point",
                            "title": "共通因数をくくりだす",
                            "content": "まず、各項に**共通な因数**があれば、それをかっこの外にくくりだします。\\n$$ ma + mb = m(a + b) $$\\n$$ 2x^2 + 4x = 2x(x + 2) $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題6: 共通因数をくくりだす",
                            "problem": "次の式を因数分解しなさい。\\n(1) $3x + 6$\\n(2) $x^2y - xy^2$",
                            "solution_steps": [
                                "(1) 共通因数は $3$。",
                                "$3(x + 2)$",
                                "(2) 共通因数は $xy$。",
                                "$xy(x - y)$"
                            ]
                        }
                    ]
                },
                {
                    "title": "公式を使った因数分解",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "乗法公式の逆を使って因数分解します。パターンを見抜くことがポイントです。"
                        },
                        {
                            "type": "point",
                            "title": "因数分解の公式",
                            "content": "**公式①** $x^2 + (a+b)x + ab = (x+a)(x+b)$\\n（和が $a+b$、積が $ab$ となる2数を見つける）\\n\\n**公式②** $x^2 + 2ax + a^2 = (x+a)^2$\\n**公式③** $x^2 - 2ax + a^2 = (x-a)^2$\\n\\n**公式④** $x^2 - a^2 = (x+a)(x-a)$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題7: 公式①を使う",
                            "problem": "$x^2 + 7x + 12$ を因数分解しなさい。",
                            "solution_steps": [
                                "和が7、積が12になる2数を探します。",
                                "$3 + 4 = 7$, $3 \\times 4 = 12$ ✓",
                                "答え: $(x + 3)(x + 4)$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題8: 公式②③を使う",
                            "problem": "次の式を因数分解しなさい。\\n(1) $x^2 + 10x + 25$\\n(2) $x^2 - 6x + 9$",
                            "solution_steps": [
                                "(1) $25 = 5^2$, $10x = 2 \\times 5 \\times x$ より、",
                                "$(x + 5)^2$",
                                "(2) $9 = 3^2$, $-6x = -2 \\times 3 \\times x$ より、",
                                "$(x - 3)^2$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題9: 公式④を使う",
                            "problem": "$x^2 - 49$ を因数分解しなさい。",
                            "solution_steps": [
                                "$49 = 7^2$ なので、2乗の差の形です。",
                                "$(x + 7)(x - 7)$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題10: 複合問題",
                            "problem": "$2x^2 - 8$ を因数分解しなさい。",
                            "solution_steps": [
                                "まず共通因数 $2$ をくくりだします。",
                                "$2(x^2 - 4)$",
                                "$x^2 - 4 = (x+2)(x-2)$ なので、",
                                "答え: $2(x + 2)(x - 2)$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$x^2 + 5x + 6$",
                                    "a": "$(x+2)(x+3)$"
                                },
                                {
                                    "q": "$x^2 - 9$",
                                    "a": "$(x+3)(x-3)$"
                                },
                                {
                                    "q": "$x^2 - 8x + 16$",
                                    "a": "$(x-4)^2$"
                                },
                                {
                                    "q": "$3x^2 - 12$",
                                    "a": "$3(x+2)(x-2)$"
                                },
                                {
                                    "q": "$x^2 - 2x - 15$",
                                    "a": "$(x+3)(x-5)$"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "因数分解の利用",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "因数分解は、式の値を求めたり、数の計算を簡単にしたりするのに使えます。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題11: 式の値",
                            "problem": "$x = 102$ のとき、$x^2 - 4x + 4$ の値を求めなさい。",
                            "solution_steps": [
                                "まず因数分解します。",
                                "$x^2 - 4x + 4 = (x - 2)^2$",
                                "$x = 102$ を代入します。",
                                "$(102 - 2)^2 = 100^2 = 10000$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$x = 99$ のとき、$x^2 + 2x + 1$ の値は？",
                                    "a": "$10000$（$(x+1)^2 = 100^2$）"
                                },
                                {
                                    "q": "$53^2 - 47^2$ を計算しなさい。",
                                    "a": "$600$（$(53+47)(53-47) = 100 \\times 6$）"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}