{
    "unit_id": "unit6_circle",
    "unit_title": "第6章 円",
    "order": 6,
    "chapters": [
        {
            "title": "1. 円周角の定理",
            "sections": [
                {
                    "title": "円周角と中心角",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "円には多くの美しい性質があります。その中でも「円周角の定理」は非常に重要で、様々な図形問題を解く鍵になります。"
                        },
                        {
                            "type": "definition",
                            "term": "弧（こ）",
                            "definition": "円周の一部を**弧**といいます。2点A, Bを端点とする弧を弧ABと書きます。"
                        },
                        {
                            "type": "definition",
                            "term": "中心角",
                            "definition": "円の**中心**から、円周上の2点へ引いた半径がつくる角を**中心角**といいます。"
                        },
                        {
                            "type": "definition",
                            "term": "円周角",
                            "definition": "**円周上の点**から、円周上の2点へ引いた線分がつくる角を**円周角**といいます。"
                        },
                        {
                            "type": "point",
                            "title": "円周角の定理",
                            "content": "**定理1**: 1つの弧に対する円周角の大きさは**一定**であり、その弧に対する**中心角の半分**である。\\n$$ \\angle APB = \\frac{1}{2} \\angle AOB $$\\n\\n**定理2**: **半円の弧に対する円周角は $90°$** である。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 円周角を求める",
                            "problem": "円Oで、弧ABに対する中心角が $80°$ のとき、弧ABに対する円周角を求めなさい。",
                            "solution_steps": [
                                "円周角 = 中心角 ÷ 2",
                                "= $80° \\div 2 = 40°$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 中心角を求める",
                            "problem": "円周角が $35°$ のとき、同じ弧に対する中心角を求めなさい。",
                            "solution_steps": [
                                "中心角 = 円周角 × 2",
                                "= $35° × 2 = 70°$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 半円の弧",
                            "problem": "直径ABの円で、円周上の点Cについて、$\\angle ACB$ の大きさを求めなさい。",
                            "solution_steps": [
                                "ABは直径なので、弧ABは半円。",
                                "半円に対する円周角は $90°$。",
                                "答え: $\\angle ACB = 90°$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "中心角が $120°$ のとき、円周角は？",
                                    "a": "$60°$"
                                },
                                {
                                    "q": "円周角が $45°$ のとき、中心角は？",
                                    "a": "$90°$"
                                },
                                {
                                    "q": "直径に対する円周角は？",
                                    "a": "$90°$"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "円周角の定理の逆",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "円周角の定理の逆",
                            "content": "4点A, B, P, Qについて、点P, Qが直線ABに対して同じ側にあり、\\n$\\angle APB = \\angle AQB$ ならば、\\n4点A, B, P, Qは**1つの円周上にある**。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 4点が同一円周上",
                            "problem": "四角形ABCDで、$\\angle B = \\angle D = 90°$ のとき、4点A, B, C, Dは同一円周上にありますか。",
                            "solution_steps": [
                                "$\\angle ABC = \\angle ADC = 90°$",
                                "弧ACに対する円周角がともに $90°$ で等しい。",
                                "したがって、4点は同一円周上にある。"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "四角形の向かい合う角の和が $180°$ のとき、4点は同一円周上？",
                                    "a": "はい（円に内接する四角形の条件）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 円と直線",
            "sections": [
                {
                    "title": "接線",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "円と直線の位置関係には、交わる、接する、離れるの3種類があります。"
                        },
                        {
                            "type": "definition",
                            "term": "接線",
                            "definition": "円と1点だけで接する直線を**接線**、その点を**接点**といいます。"
                        },
                        {
                            "type": "point",
                            "title": "接線の性質",
                            "content": "円の接線は、接点を通る**半径に垂直**である。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: 接線の角度",
                            "problem": "円Oの接線が点Pで接している。OPと接線のなす角は？",
                            "solution_steps": [
                                "接線は半径に垂直なので、",
                                "OPと接線のなす角 = $90°$"
                            ]
                        },
                        {
                            "type": "point",
                            "title": "接線の長さ",
                            "content": "円外の1点から引いた2本の接線の長さは等しい。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題6: 接線の長さ",
                            "problem": "点Pから円Oに引いた2本の接線の接点をA, Bとする。PA = 6cm のとき、PBの長さは？",
                            "solution_steps": [
                                "円外の1点から引いた2本の接線の長さは等しい。",
                                "PB = PA = 6cm"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "接線と半径のなす角は？",
                                    "a": "$90°$"
                                },
                                {
                                    "q": "円外の点から2本の接線を引くと、接線の長さは？",
                                    "a": "等しい"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}