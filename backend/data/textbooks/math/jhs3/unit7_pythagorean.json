{
    "unit_id": "unit7_pythagorean",
    "unit_title": "第7章 三平方の定理",
    "order": 7,
    "chapters": [
        {
            "title": "1. 三平方の定理",
            "sections": [
                {
                    "title": "定理の意味",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "古代ギリシャの数学者ピタゴラスが発見したとされる「三平方の定理」は、数学の中で最も有名な定理の1つです。直角三角形の3辺の関係を表します。"
                        },
                        {
                            "type": "point",
                            "title": "三平方の定理（ピタゴラスの定理）",
                            "content": "直角三角形の**直角をはさむ2辺**の長さを $a$, $b$、**斜辺**の長さを $c$ とすると、\\n$$ a^2 + b^2 = c^2 $$\\nが成り立つ。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 斜辺を求める",
                            "problem": "直角をはさむ2辺の長さが 3cm, 4cm の直角三角形の斜辺の長さを求めなさい。",
                            "solution_steps": [
                                "斜辺を $c$ とすると、$3^2 + 4^2 = c^2$",
                                "$9 + 16 = c^2$",
                                "$c^2 = 25$",
                                "$c > 0$ なので $c = 5$",
                                "答え: **5cm**"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 他の辺を求める",
                            "problem": "斜辺が 13cm、一方の辺が 5cm の直角三角形の、残りの辺の長さを求めなさい。",
                            "solution_steps": [
                                "残りの辺を $a$ とすると、$a^2 + 5^2 = 13^2$",
                                "$a^2 + 25 = 169$",
                                "$a^2 = 144$",
                                "$a = 12$",
                                "答え: **12cm**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "2辺が 6cm, 8cm の直角三角形の斜辺は？",
                                    "a": "10cm"
                                },
                                {
                                    "q": "斜辺が 10cm、一方の辺が 6cm のとき、残りの辺は？",
                                    "a": "8cm"
                                },
                                {
                                    "q": "2辺が 5cm, 12cm の直角三角形の斜辺は？",
                                    "a": "13cm"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "特別な直角三角形",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "特定の角度を持つ直角三角形には、覚えておくと便利な辺の比があります。"
                        },
                        {
                            "type": "point",
                            "title": "45°-45°-90° の直角三角形",
                            "content": "直角二等辺三角形の辺の比は\\n$$ 1 : 1 : \\sqrt{2} $$\\n（2つの直角をはさむ辺が等しく、斜辺が $\\sqrt{2}$ 倍）"
                        },
                        {
                            "type": "point",
                            "title": "30°-60°-90° の直角三角形",
                            "content": "辺の比は\\n$$ 1 : \\sqrt{3} : 2 $$\\n- 30°の向かいの辺が 1\\n- 60°の向かいの辺が $\\sqrt{3}$\\n- 斜辺（90°の向かい）が 2"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 45°-45°-90°",
                            "problem": "直角二等辺三角形の直角をはさむ辺が 5cm のとき、斜辺の長さを求めなさい。",
                            "solution_steps": [
                                "辺の比 $1:1:\\sqrt{2}$ より、",
                                "斜辺 = $5\\sqrt{2}$ cm"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 30°-60°-90°",
                            "problem": "30°-60°-90° の直角三角形で、斜辺が 8cm のとき、他の2辺の長さを求めなさい。",
                            "solution_steps": [
                                "辺の比 $1:\\sqrt{3}:2$ で、斜辺が 8 なので比が 2→8 （4倍）",
                                "30°の向かいの辺 = $1 \\times 4 = 4$ cm",
                                "60°の向かいの辺 = $\\sqrt{3} \\times 4 = 4\\sqrt{3}$ cm"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "直角二等辺三角形で斜辺が $6\\sqrt{2}$ cm のとき、他の辺は？",
                                    "a": "6cm"
                                },
                                {
                                    "q": "30°-60°-90° で短い辺が 3cm のとき、斜辺は？",
                                    "a": "6cm"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 三平方の定理の利用",
            "sections": [
                {
                    "title": "平面図形への応用",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "三平方の定理は、様々な図形の辺や高さを求めるのに使えます。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: 正三角形の高さ",
                            "problem": "1辺が 6cm の正三角形の高さを求めなさい。",
                            "solution_steps": [
                                "頂点から底辺に垂線を下ろすと、底辺は2等分される。",
                                "直角三角形ができ、斜辺6cm、底辺3cm。",
                                "$h^2 + 3^2 = 6^2$",
                                "$h^2 = 36 - 9 = 27$",
                                "$h = \\sqrt{27} = 3\\sqrt{3}$ cm"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題6: 2点間の距離",
                            "problem": "座標平面上の2点 A$(1, 2)$, B$(4, 6)$ の距離を求めなさい。",
                            "solution_steps": [
                                "x方向の差: $4 - 1 = 3$",
                                "y方向の差: $6 - 2 = 4$",
                                "距離 = $\\sqrt{3^2 + 4^2} = \\sqrt{25} = 5$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "1辺が 4cm の正三角形の高さは？",
                                    "a": "$2\\sqrt{3}$ cm"
                                },
                                {
                                    "q": "A$(0, 0)$, B$(5, 12)$ の距離は？",
                                    "a": "13"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "空間図形への応用",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "三平方の定理は3次元の空間図形でも使えます。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題7: 直方体の対角線",
                            "problem": "縦3cm、横4cm、高さ5cmの直方体の対角線の長さを求めなさい。",
                            "solution_steps": [
                                "まず底面の対角線: $\\sqrt{3^2 + 4^2} = 5$",
                                "次に空間の対角線: $\\sqrt{5^2 + 5^2} = \\sqrt{50} = 5\\sqrt{2}$ cm",
                                "（または一度に $\\sqrt{3^2 + 4^2 + 5^2} = \\sqrt{50}$）"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題8: 円錐の母線",
                            "problem": "底面の半径が 3cm、高さが 4cm の円錐の母線の長さを求めなさい。",
                            "solution_steps": [
                                "母線は、頂点から底面の円周への線。",
                                "半径と高さで直角三角形ができる。",
                                "母線 = $\\sqrt{3^2 + 4^2} = 5$ cm"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "1辺が 2cm の立方体の対角線の長さは？",
                                    "a": "$2\\sqrt{3}$ cm"
                                },
                                {
                                    "q": "底面の半径5cm、高さ12cmの円錐の母線は？",
                                    "a": "13cm"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}