{
    "unit_id": "unit2_sequences",
    "unit_title": "第2章 数列",
    "order": 2,
    "chapters": [
        {
            "title": "1. 等差数列・等比数列",
            "sections": [
                {
                    "title": "等差数列",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "規則的に並んだ数の列を「数列」といいます。隣り合う項の差が一定のものを「等差数列」といいます。"
                        },
                        {
                            "type": "definition",
                            "term": "等差数列",
                            "definition": "隣り合う項の差（**公差** $d$）が一定の数列。\\n例: 2, 5, 8, 11, ... （公差3）"
                        },
                        {
                            "type": "point",
                            "title": "等差数列の公式",
                            "content": "初項 $a$、公差 $d$ のとき\\n- 一般項: $a_n = a + (n-1)d$\\n- 和: $S_n = \\frac{n(a + a_n)}{2} = \\frac{n(2a + (n-1)d)}{2}$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 等差数列",
                            "problem": "初項3、公差4の等差数列の第10項と、初項から第10項までの和を求めよ。",
                            "solution_steps": [
                                "$a_{10} = 3 + 9 \\times 4 = 39$",
                                "$S_{10} = \\frac{10(3 + 39)}{2} = \\frac{420}{2} = 210$"
                            ]
                        }
                    ]
                },
                {
                    "title": "等比数列",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "等比数列",
                            "definition": "隣り合う項の比（**公比** $r$）が一定の数列。\\n例: 2, 6, 18, 54, ... （公比3）"
                        },
                        {
                            "type": "point",
                            "title": "等比数列の公式",
                            "content": "初項 $a$、公比 $r$ のとき\\n- 一般項: $a_n = ar^{n-1}$\\n- 和 ($r \\neq 1$): $S_n = \\frac{a(1 - r^n)}{1 - r} = \\frac{a(r^n - 1)}{r - 1}$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 等比数列",
                            "problem": "初項2、公比3の等比数列の第5項と、初項から第5項までの和を求めよ。",
                            "solution_steps": [
                                "$a_5 = 2 \\times 3^4 = 2 \\times 81 = 162$",
                                "$S_5 = \\frac{2(3^5 - 1)}{3 - 1} = \\frac{2 \\times 242}{2} = 242$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "初項5、公差-2の等差数列の第8項は？",
                                    "a": "$-9$"
                                },
                                {
                                    "q": "初項1、公比2の等比数列の第6項は？",
                                    "a": "$32$"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. いろいろな数列",
            "sections": [
                {
                    "title": "Σ記号と和の公式",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "Σ（シグマ）記号",
                            "content": "$\\sum_{k=1}^{n} a_k = a_1 + a_2 + ... + a_n$"
                        },
                        {
                            "type": "point",
                            "title": "基本公式",
                            "content": "$\\sum_{k=1}^{n} k = \\frac{n(n+1)}{2}$\\n$\\sum_{k=1}^{n} k^2 = \\frac{n(n+1)(2n+1)}{6}$\\n$\\sum_{k=1}^{n} k^3 = \\left(\\frac{n(n+1)}{2}\\right)^2$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: Σの計算",
                            "problem": "$\\sum_{k=1}^{10} k$ を求めよ。",
                            "solution_steps": [
                                "$\\frac{10 \\times 11}{2} = 55$"
                            ]
                        }
                    ]
                },
                {
                    "title": "漸化式",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "漸化式",
                            "definition": "隣り合う項の関係を表す式。\\n例: $a_{n+1} = 2a_n + 1$, $a_1 = 1$"
                        },
                        {
                            "type": "point",
                            "title": "代表的な漸化式",
                            "content": "1. $a_{n+1} = a_n + d$ → 等差数列\\n2. $a_{n+1} = ra_n$ → 等比数列\\n3. $a_{n+1} = pa_n + q$ → 特性方程式で解く"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 漸化式",
                            "problem": "$a_1 = 2$, $a_{n+1} = 3a_n - 2$ の一般項を求めよ。",
                            "solution_steps": [
                                "特性方程式: $\\alpha = 3\\alpha - 2$ → $\\alpha = 1$",
                                "$a_{n+1} - 1 = 3(a_n - 1)$",
                                "$b_n = a_n - 1$ とおくと、$b_{n+1} = 3b_n$, $b_1 = 1$",
                                "$b_n = 3^{n-1}$",
                                "$a_n = 3^{n-1} + 1$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$\\sum_{k=1}^{5} k^2$ を求めよ",
                                    "a": "$55$"
                                },
                                {
                                    "q": "$a_1 = 1$, $a_{n+1} = a_n + 3$ の $a_{10}$ は？",
                                    "a": "$28$"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}