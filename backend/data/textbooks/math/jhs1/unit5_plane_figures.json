    "order": 5,
    "chapters": [
        {
            "title": "1. 平面図形の基礎",
            "sections": [
                {
                    "title": "直線と角",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "直線・半直線・線分",
                            "definition": "- **直線AB**: 2点A, Bを通って限りなく伸びる線。\n- **半直線AB**: 点Aを端として、点Bの方向に限りなく伸びる線。\n- **線分AB**: 2点A, Bを結ぶ線。"
                        },
                        {
                            "type": "definition",
                            "term": "垂直と平行",
                            "definition": "- **垂直 ($\u22a5$)**: 2直線が直角に交わること。\n- **平行 (//)**: 2直線がどこまで伸ばしても交わらないこと。"
                        }
                    ]
                },
                {
                    "title": "図形の移動",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "3つの移動",
                            "content": "1. **平行移動**: 図形を一定の方向に、一定の距離だけずらす移動。\n2. **回転移動**: 図形をある点（回転の中心）を中心として、一定の角度だけ回す移動。\n3. **対称移動**: 図形をある直線（対称の軸）を折り目として折り返す移動。"
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. おうぎ形",
            "sections": [
                {
                    "title": "おうぎ形の計量",
                    "content_blocks": [
                        {
                            "type": "explanation",
                            "markdown": "半径 $r$、中心角 $a^\\circ$ のおうぎ形について学びます。"
                        },
                        {
                            "type": "point",
                            "title": "弧の長さ ($l$)",
                            "content": "円周の長さに、中心角の割合をかけます。\n$$ l = 2\\pi r \\times \\frac{a}{360} $$"
                        },
                        {
                            "type": "point",
                            "title": "面積 ($S$)",
                            "content": "円の面積に、中心角の割合をかけます。\n$$ S = \\pi r^2 \\times \\frac{a}{360} $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題: おうぎ形の計算",
                            "problem": "半径 6cm, 中心角 120° のおうぎ形の弧の長さと面積を求めなさい。",
                            "solution_steps": [
                                "弧の長さ $l = 2\\pi \\times 6 \\times \\frac{120}{360} = 12\\pi \\times \\frac{1}{3} = 4\\pi$",
                                "面積 $S = \\pi \\times 6^2 \\times \\frac{120}{360} = 36\\pi \\times \\frac{1}{3} = 12\\pi$",
                                "答え: 弧の長さ $4\\pi$ cm, 面積 $12\\pi$ cm²"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}