{
    "unit_id": "unit3_linear_functions",
    "unit_title": "第3章 一次関数",
    "order": 3,
    "chapters": [
        {
            "title": "1. 一次関数",
            "sections": [
                {
                    "title": "一次関数の意味",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "一次関数",
                            "definition": "$y$ が $x$ の関数で、$y = ax + b$ （$a, b$は定数, $a \\neq 0$）で表されるとき、$y$ は $x$ の一次関数であるという。"
                        },
                        {
                            "type": "point",
                            "title": "変化の割合",
                            "content": "一次関数 $y = ax + b$ では、変化の割合は一定で $a$ に等しい。\n$$ \\text{変化の割合} = a = \\frac{y\\text{の増加量}}{x\\text{の増加量}} $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題: 変化の割合",
                            "problem": "一次関数 $y = 2x + 3$ について、$x$ の値が 1 から 4 まで増加するときの変化の割合と、$y$ の増加量を求めなさい。",
                            "solution_steps": [
                                "変化の割合は $x$ の係数なので **2**。",
                                "$x$ の増加量は $4 - 1 = 3$。",
                                "$y$ の増加量 = 変化の割合 $\\times$ $x$ の増加量 なので、$2 \\times 3 = 6$。",
                                "答え: 変化の割合 2, $y$ の増加量 6"
                            ]
                        }
                    ]
                },
                {
                    "title": "一次関数のグラフ",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "切片（せっぺん）",
                            "definition": "グラフが y軸と交わる点の y座標。$y = ax + b$ の $b$。"
                        },
                        {
                            "type": "definition",
                            "term": "傾き",
                            "definition": "直線の傾き具合。$y = ax + b$ の $a$。"
                        },
                        {
                            "type": "point",
                            "title": "グラフのかき方",
                            "content": "1. 切片 $b$ をy軸上にとる。\n2. 傾き $a = \\frac{\\Delta y}{\\Delta x}$ を利用して、次の点を見つける。\n3. 2点を直線で結ぶ。"
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 一次関数の利用",
            "sections": [
                {
                    "title": "直線の式を求める",
                    "content_blocks": [
                        {
                            "type": "example_problem",
                            "title": "例題: 2点を通る直線",
                            "problem": "2点 A(1, 4), B(3, 10) を通る直線の式を求めなさい。",
                            "solution_steps": [
                                "求める式を $y = ax + b$ とします。",
                                "2点の座標を代入して、連立方程式をつくります。",
                                "$$ \\begin{cases} 4 = a + b \\dots\\text{①} \\\\ 10 = 3a + b \\dots\\text{②} \\end{cases} $$",
                                "② - ① より、$6 = 2a \\rightarrow a = 3$。",
                                "$a=3$ を①に代入して $4 = 3 + b \\rightarrow b = 1$。",
                                "答え: $y = 3x + 1$"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}