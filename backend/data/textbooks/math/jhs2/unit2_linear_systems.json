    "order": 2,
    "chapters": [
        {
            "title": "1. 連立方程式とその解き方",
            "sections": [
                {
                    "title": "連立方程式",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "二元一次方程式",
                            "definition": "$2x + y = 5$ のように、2種類の文字を含む一次方程式。"
                        },
                        {
                            "type": "definition",
                            "term": "連立方程式",
                            "definition": "2つ以上の方程式を組み合わせたもの。"
                        }
                    ]
                },
                {
                    "title": "加減法（かげんほう）",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "加減法の手順",
                            "content": "1. どちらかの文字の係数の絶対値をそろえる。\n2. 左辺どうし、右辺どうしを足すか引いて、文字を1つ消去する。\n3. 一次方程式として解く。\n4. 求めた解を元の式に代入して、もう1つの文字を求める。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題: 加減法",
                            "problem": "次の連立方程式を解きなさい。\n$$ \\begin{cases} x + 2y = 8 \\dots\\text{①} \\\\ x - y = 2 \\dots\\text{②} \\end{cases} $$",
                            "solution_steps": [
                                "$x$ の係数がそろっているので、①から②を引きます。",
                                "$$ (x+2y) - (x-y) = 8 - 2 $$",
                                "$$ 3y = 6 $$",
                                "$$ y = 2 $$",
                                "求めた $y=2$ を②に代入します。",
                                "$$ x - 2 = 2 \\rightarrow x = 4 $$",
                                "答え: $x=4, y=2$"
                            ]
                        }
                    ]
                },
                {
                    "title": "代入法（だいにゅうほう）",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "代入法の手順",
                            "content": "一方の式を他方の式の文字に代入して解く方法。\n例: $y = x+1$ という式があれば、もう一方の式の $y$ を $(x+1)$ に置き換える。"
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 連立方程式の利用",
            "sections": [
                {
                    "title": "文章題の解き方",
                    "content_blocks": [
                        {
                            "type": "explanation",
                            "markdown": "1. 求めたい数量を $x, y$ とおく。\n2. 問題文から等しい関係を見つけ、2つの方程式をつくる。\n3. 連立方程式を解く。\n4. 解が問題に適しているか確かめる。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題: 個数と代金",
                            "problem": "りんご2個とみかん3個を買うと560円、りんご1個とみかん4個を買うと480円でした。りんごとみかん1個の値段は？",
                            "solution_steps": [
                                "りんご1個を $x$円、みかん1個を $y$円とします。",
                                "$$ \\begin{cases} 2x + 3y = 560 \\\\ x + 4y = 480 \\end{cases} $$",
                                "第2式を2倍して $2x + 8y = 960$。",
                                "引き算すると $-5y = -400 \\rightarrow y = 80$。",
                                "$y=80$ を第2式に代入: $x + 320 = 480 \\rightarrow x = 160$。",
                                "答え: りんご160円、みかん80円"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}