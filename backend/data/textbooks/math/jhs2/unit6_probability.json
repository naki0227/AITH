{
    "unit_id": "unit6_probability",
    "unit_title": "第6章 確率",
    "order": 6,
    "chapters": [
        {
            "title": "1. 確率の意味",
            "sections": [
                {
                    "title": "確率とは",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "「サイコロで6が出る確率は？」「雨が降る確率は？」日常でよく使う「確率」を、数学的に正しく理解しましょう。"
                        },
                        {
                            "type": "definition",
                            "term": "確率",
                            "definition": "ある事柄が起こることの起こりやすさを0から1（または0%から100%）の数で表したもの。"
                        },
                        {
                            "type": "definition",
                            "term": "同様に確からしい",
                            "definition": "どの場合が起こることも**同じ程度に期待できる**こと。公正なサイコロやコインは「同様に確からしい」といえます。"
                        },
                        {
                            "type": "point",
                            "title": "確率の基本公式",
                            "content": "起こりうる全ての場合の数を $N$、事柄Aの起こる場合の数を $a$ とすると、\\n$$ P(A) = \\frac{a}{N} $$\\n※ $0 \\leq P(A) \\leq 1$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: サイコロの確率",
                            "problem": "1つのサイコロを投げるとき、奇数の目が出る確率を求めなさい。",
                            "solution_steps": [
                                "全ての場合の数: 1, 2, 3, 4, 5, 6 の **6通り**",
                                "奇数の目: 1, 3, 5 の **3通り**",
                                "確率 = $\\frac{3}{6} = \\frac{1}{2}$",
                                "答え: $\\frac{1}{2}$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: トランプの確率",
                            "problem": "52枚のトランプから1枚引くとき、ハートのカードを引く確率を求めなさい。",
                            "solution_steps": [
                                "全ての場合の数: **52通り**",
                                "ハートのカード: **13通り**",
                                "確率 = $\\frac{13}{52} = \\frac{1}{4}$",
                                "答え: $\\frac{1}{4}$"
                            ]
                        },
                        {
                            "type": "point",
                            "title": "確率の性質",
                            "content": "1. **必ず起こる**事柄の確率は **1**\\n2. **絶対に起こらない**事柄の確率は **0**\\n3. 事柄Aが「起こらない」確率は $1 - P(A)$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 起こらない確率",
                            "problem": "サイコロを投げて、6以外の目が出る確率を求めなさい。",
                            "solution_steps": [
                                "6が出る確率 = $\\frac{1}{6}$",
                                "6以外が出る確率 = $1 - \\frac{1}{6} = \\frac{5}{6}$",
                                "答え: $\\frac{5}{6}$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "サイコロで偶数の目が出る確率は？",
                                    "a": "$\\frac{1}{2}$"
                                },
                                {
                                    "q": "サイコロで7の目が出る確率は？",
                                    "a": "$0$（不可能）"
                                },
                                {
                                    "q": "トランプでスペードのエースを引く確率は？",
                                    "a": "$\\frac{1}{52}$"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. いろいろな確率",
            "sections": [
                {
                    "title": "樹形図",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "複数の事柄が連続して起こる場合、すべての場合を漏れなく数え上げるために「樹形図」を使います。"
                        },
                        {
                            "type": "point",
                            "title": "樹形図とは",
                            "content": "枝分かれした図で、起こりうる全ての場合を視覚的に表したもの。\\n例: コインを2回投げる場合\\n```\\n1回目 → 2回目\\n  表 → 表 (表,表)\\n     → 裏 (表,裏)\\n  裏 → 表 (裏,表)\\n     → 裏 (裏,裏)\\n```"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 2枚のコイン",
                            "problem": "2枚のコインを同時に投げるとき、1枚が表で1枚が裏になる確率を求めなさい。",
                            "solution_steps": [
                                "全ての場合: (表,表), (表,裏), (裏,表), (裏,裏) の **4通り**",
                                "1枚が表で1枚が裏: (表,裏), (裏,表) の **2通り**",
                                "確率 = $\\frac{2}{4} = \\frac{1}{2}$",
                                "答え: $\\frac{1}{2}$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: 3枚のコイン",
                            "problem": "3枚のコインを同時に投げるとき、少なくとも1枚は表になる確率を求めなさい。",
                            "solution_steps": [
                                "全ての場合: $2^3 = 8$ 通り",
                                "少なくとも1枚表 = 全体 - すべて裏",
                                "すべて裏: (裏,裏,裏) の **1通り**",
                                "少なくとも1枚表: $8 - 1 = 7$ 通り",
                                "確率 = $\\frac{7}{8}$",
                                "答え: $\\frac{7}{8}$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "コインを2回投げて、両方とも表になる確率は？",
                                    "a": "$\\frac{1}{4}$"
                                },
                                {
                                    "q": "コインを3回投げて、ちょうど2回表が出る確率は？",
                                    "a": "$\\frac{3}{8}$"
                                },
                                {
                                    "q": "コインを4回投げるとき、全ての場合の数は？",
                                    "a": "$16$ 通り"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "表を使う方法",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "2つのサイコロを投げるなど、2種類のものの組み合わせを考えるときは、表を使うと便利です。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題6: 2つのサイコロ",
                            "problem": "大小2つのサイコロを投げるとき、出た目の和が7になる確率を求めなさい。",
                            "solution_steps": [
                                "全ての場合の数: $6 \\times 6 = 36$ 通り",
                                "和が7になる組み合わせ:",
                                "(1,6), (2,5), (3,4), (4,3), (5,2), (6,1) の **6通り**",
                                "確率 = $\\frac{6}{36} = \\frac{1}{6}$",
                                "答え: $\\frac{1}{6}$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題7: サイコロの積",
                            "problem": "2つのサイコロを投げるとき、出た目の積が12になる確率を求めなさい。",
                            "solution_steps": [
                                "全ての場合の数: **36通り**",
                                "積が12になる組み合わせ:",
                                "(2,6), (3,4), (4,3), (6,2) の **4通り**",
                                "確率 = $\\frac{4}{36} = \\frac{1}{9}$",
                                "答え: $\\frac{1}{9}$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "2つのサイコロの目の和が2になる確率は？",
                                    "a": "$\\frac{1}{36}$"
                                },
                                {
                                    "q": "2つのサイコロの目の和が偶数になる確率は？",
                                    "a": "$\\frac{1}{2}$"
                                },
                                {
                                    "q": "2つのサイコロで、両方とも6が出る確率は？",
                                    "a": "$\\frac{1}{36}$"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "くじ引きの確率",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "くじ引きでは「順番によって確率が変わるのでは？」と思うかもしれませんが、実は順番に関係なく確率は同じです。"
                        },
                        {
                            "type": "point",
                            "title": "くじ引きの公平性",
                            "content": "5本のくじの中に1本の当たりがあるとき、\\n- 1番目に引く人が当たる確率: $\\frac{1}{5}$\\n- 2番目に引く人が当たる確率: $\\frac{1}{5}$\\n\\n**どの順番で引いても確率は同じ！**"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題8: くじ引き",
                            "problem": "10本のくじの中に当たりが2本あります。1本ずつ2本引くとき、2本とも当たりになる確率を求めなさい。",
                            "solution_steps": [
                                "1本目が当たりの確率: $\\frac{2}{10} = \\frac{1}{5}$",
                                "1本目が当たりのとき、2本目も当たりの確率: $\\frac{1}{9}$（残り9本中1本が当たり）",
                                "2本とも当たり: $\\frac{1}{5} \\times \\frac{1}{9} = \\frac{1}{45}$",
                                "答え: $\\frac{1}{45}$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題9: カードを引く",
                            "problem": "1から5までの数字が書かれた5枚のカードから2枚を引くとき、2枚の和が6になる確率を求めなさい。",
                            "solution_steps": [
                                "2枚の選び方: ${}_5C_2 = 10$ 通り",
                                "和が6になる: (1,5), (2,4) の **2通り**",
                                "確率 = $\\frac{2}{10} = \\frac{1}{5}$",
                                "答え: $\\frac{1}{5}$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "6本中2本当たりのくじで、1本目に当たる確率は？",
                                    "a": "$\\frac{1}{3}$"
                                },
                                {
                                    "q": "1～4の4枚から2枚引いて和が奇数になる確率は？",
                                    "a": "$\\frac{2}{3}$（6通り中4通り）"
                                },
                                {
                                    "q": "赤玉3個、白玉2個の袋から1個取り出すとき、赤玉の確率は？",
                                    "a": "$\\frac{3}{5}$"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}