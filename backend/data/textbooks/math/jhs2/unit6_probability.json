{
    "unit_id": "unit6_probability",
    "unit_title": "第6章 確率",
    "order": 6,
    "chapters": [
        {
            "title": "1. 確率の意味",
            "sections": [
                {
                    "title": "確率の求め方",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "同様に確からしい",
                            "definition": "どの場合が起こることも同じ程度に期待できること。"
                        },
                        {
                            "type": "point",
                            "title": "確率の公式",
                            "content": "起こりうる全ての場合の数を $N$、事柄 A の起こる場合の数を $a$ とすると、\n$$ P(A) = \\frac{a}{N} $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題: サイコロの確率",
                            "problem": "1つのサイコロを投げるとき、奇数の目が出る確率を求めなさい。",
                            "solution_steps": [
                                "全ての場合の数は 1, 2, 3, 4, 5, 6 の **6通り**。",
                                "奇数の目は 1, 3, 5 の **3通り**。",
                                "確率は $\\frac{3}{6} = \\frac{1}{2}$。",
                                "答え: $\\frac{1}{2}$"
                            ]
                        }
                    ]
                },
                {
                    "title": "いろいろな確率",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "樹形図",
                            "content": "コインを2回投げるなど、連続して起こる事柄の場合の数を漏れなく数え上げるために、枝分かれした図（樹形図）を使うと便利です。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題: 2枚のコイン",
                            "problem": "2枚のコインA, Bを同時に投げるとき、1枚が表で1枚が裏になる確率を求めなさい。",
                            "solution_steps": [
                                "表を○、裏を×とします。",
                                "全ての場合は (○,○), (○,×), (×,○), (×,×) の **4通り**。",
                                "1枚が表、1枚が裏になるのは (○,×) と (×,○) の **2通り**。",
                                "確率は $\\frac{2}{4} = \\frac{1}{2}$。",
                                "答え: $\\frac{1}{2}$"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}