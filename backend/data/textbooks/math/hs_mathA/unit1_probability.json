{
    "unit_id": "unit1_probability",
    "unit_title": "第1章 場合の数と確率",
    "order": 1,
    "chapters": [
        {
            "title": "1. 場合の数",
            "sections": [
                {
                    "title": "数え上げの基本原理",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "「全部で何通り？」という問題を解くには、場合の数を正しく数える技術が必要です。まずは基本となる2つの原理を学びましょう。"
                        },
                        {
                            "type": "point",
                            "title": "和の法則",
                            "content": "事象Aと事象Bが**同時に起こらない**とき、\\nAまたはBの場合の数 = Aの場合の数 + Bの場合の数"
                        },
                        {
                            "type": "point",
                            "title": "積の法則",
                            "content": "事象Aと事象Bが**独立**に起こるとき、\\nAかつBの場合の数 = Aの場合の数 × Bの場合の数"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 基本原理",
                            "problem": "1から6の目があるサイコロを2回振る。目の和が奇数になる場合の数を求めよ。",
                            "solution_steps": [
                                "和が奇数 = 奇数 + 偶数 または 偶数 + 奇数",
                                "1回目が奇数(1,3,5の3通り) × 2回目が偶数(2,4,6の3通り) = 9通り",
                                "1回目が偶数 × 2回目が奇数 = 9通り",
                                "和の法則より、$9 + 9 = 18$ 通り"
                            ]
                        }
                    ]
                },
                {
                    "title": "順列",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "「5人でリレーの走順を決める」など、順番が意味を持つ場合を扱います。"
                        },
                        {
                            "type": "definition",
                            "term": "階乗",
                            "definition": "$n! = n \\times (n-1) \\times ... \\times 2 \\times 1$\\n例: $5! = 120$、$0! = 1$（定義）"
                        },
                        {
                            "type": "definition",
                            "term": "順列 $_nP_r$",
                            "definition": "異なる $n$ 個から $r$ 個選んで**並べる**場合の数。\\n$$ _nP_r = \\frac{n!}{(n-r)!} = n(n-1)...(n-r+1) $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 順列",
                            "problem": "7人から委員長、副委員長、書記を1人ずつ選ぶ方法は何通りか。",
                            "solution_steps": [
                                "役職が異なる = 順序が区別される → 順列",
                                "$_7P_3 = 7 \\times 6 \\times 5 = 210$ 通り"
                            ]
                        },
                        {
                            "type": "point",
                            "title": "円順列",
                            "definition": "回転して同じになるものを1通りと数える。\\n$n$ 個の円順列 = $(n-1)!$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 円順列",
                            "problem": "5人が円卓に座る方法は何通りか。",
                            "solution_steps": [
                                "円順列なので $(5-1)! = 4! = 24$ 通り"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$_5P_2$ の値は？",
                                    "a": "$20$"
                                },
                                {
                                    "q": "6人が一列に並ぶ方法は何通り？",
                                    "a": "$720$（$6!$）"
                                },
                                {
                                    "q": "4人の円順列は何通り？",
                                    "a": "$6$（$3!$）"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "組合せ",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "「5人から掃除当番を2人選ぶ」など、順番が関係ない場合を扱います。"
                        },
                        {
                            "type": "definition",
                            "term": "組合せ $_nC_r$",
                            "definition": "異なる $n$ 個から $r$ 個選ぶ（順序無視）場合の数。\\n$$ _nC_r = \\frac{_nP_r}{r!} = \\frac{n!}{r!(n-r)!} $$"
                        },
                        {
                            "type": "point",
                            "title": "組合せの性質",
                            "content": "1. $_nC_0 = _nC_n = 1$\\n2. $_nC_r = _nC_{n-r}$（対称性）\\n3. $_nC_r = _{n-1}C_{r-1} + _{n-1}C_r$（パスカルの三角形）"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 組合せ",
                            "problem": "7人から掃除当番を3人選ぶ方法は何通りか。",
                            "solution_steps": [
                                "全員同じ役割 = 順序関係なし → 組合せ",
                                "$_7C_3 = \\frac{7 \\times 6 \\times 5}{3!} = \\frac{210}{6} = 35$ 通り"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: グループ分け",
                            "problem": "6人を2人ずつ3組に分ける方法は何通りか。",
                            "solution_steps": [
                                "6人から2人選ぶ × 残り4人から2人選ぶ × 残り2人から2人選ぶ",
                                "$_6C_2 \\times _4C_2 \\times _2C_2 = 15 \\times 6 \\times 1 = 90$",
                                "ただし3組の区別がないので $3! = 6$ で割る",
                                "$\\frac{90}{6} = 15$ 通り"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$_{10}C_3$ の値は？",
                                    "a": "$120$"
                                },
                                {
                                    "q": "$_{10}C_7$ は $_{10}C_?$ と等しい？",
                                    "a": "$_{10}C_3$"
                                },
                                {
                                    "q": "トランプ52枚から5枚選ぶ方法は？",
                                    "a": "$2598960$通り"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 確率",
            "sections": [
                {
                    "title": "確率の基本",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "確率",
                            "definition": "事象Aが起こる確率 $P(A) = \\frac{\\text{Aの場合の数}}{\\text{全事象の場合の数}}$\\n$0 \\le P(A) \\le 1$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題6: サイコロの確率",
                            "problem": "大小2つのサイコロを投げるとき、目の和が5になる確率を求めよ。",
                            "solution_steps": [
                                "全事象: $6 \\times 6 = 36$ 通り",
                                "和が5: (1,4), (2,3), (3,2), (4,1) の4通り",
                                "$P = \\frac{4}{36} = \\frac{1}{9}$"
                            ]
                        }
                    ]
                },
                {
                    "title": "余事象と加法定理",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "余事象の確率",
                            "content": "$P(\\bar{A}) = 1 - P(A)$\\n「少なくとも1つ」「〜でない」は余事象が有効"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題7: 余事象",
                            "problem": "コインを3回投げて、少なくとも1回は表が出る確率を求めよ。",
                            "solution_steps": [
                                "余事象「すべて裏」の確率を求める",
                                "$P(すべて裏) = (\\frac{1}{2})^3 = \\frac{1}{8}$",
                                "$P(少なくとも1回表) = 1 - \\frac{1}{8} = \\frac{7}{8}$"
                            ]
                        },
                        {
                            "type": "point",
                            "title": "加法定理",
                            "content": "$P(A \\cup B) = P(A) + P(B) - P(A \\cap B)$\\nA, Bが排反（同時に起こらない）なら $P(A \\cup B) = P(A) + P(B)$"
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$P(A) = 0.6$ のとき $P(\\bar{A})$ は？",
                                    "a": "$0.4$"
                                },
                                {
                                    "q": "サイコロで偶数または3以下が出る確率は？",
                                    "a": "$\\frac{2}{3}$"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "独立試行と反復試行",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "独立試行の確率",
                            "content": "独立な事象A, Bがともに起こる確率は\\n$P(A \\cap B) = P(A) \\times P(B)$"
                        },
                        {
                            "type": "point",
                            "title": "反復試行の確率",
                            "content": "成功確率 $p$ の試行を $n$ 回行い、ちょうど $r$ 回成功する確率は\\n$$ _nC_r \\cdot p^r \\cdot (1-p)^{n-r} $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題8: 反復試行",
                            "problem": "サイコロを5回投げて、ちょうど2回6が出る確率を求めよ。",
                            "solution_steps": [
                                "6が出る確率 $p = \\frac{1}{6}$、出ない確率 $1-p = \\frac{5}{6}$",
                                "$_5C_2 \\times (\\frac{1}{6})^2 \\times (\\frac{5}{6})^3$",
                                "$= 10 \\times \\frac{1}{36} \\times \\frac{125}{216}$",
                                "$= \\frac{1250}{7776} = \\frac{625}{3888}$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "コインを4回投げてちょうど3回表が出る確率は？",
                                    "a": "$\\frac{1}{4}$"
                                },
                                {
                                    "q": "当たり確率$\\frac{1}{3}$のくじを2回引いて2回とも当たる確率は？",
                                    "a": "$\\frac{1}{9}$"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}