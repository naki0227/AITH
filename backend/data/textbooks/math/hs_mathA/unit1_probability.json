{
    "unit_id": "unit1_probability",
    "unit_title": "第1章 場合の数と確率",
    "order": 1,
    "chapters": [
        {
            "title": "1. 場合の数",
            "sections": [
                {
                    "title": "順列・組合せ",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "「5人でリレーの走順を決める」のは順序が大事なので順列。「5人から掃除当番を2人選ぶ」のは順序関係ないので組合せ。この違いをマスターしましょう。"
                        },
                        {
                            "type": "definition",
                            "term": "階乗 (Factorial)",
                            "definition": "$n! = n \\times (n-1) \\times ... \\times 2 \\times 1$\n例: $3! = 3 \\times 2 \\times 1 = 6$"
                        },
                        {
                            "type": "definition",
                            "term": "順列 ($ _nP_r $)",
                            "definition": "異なる $n$ 個から $r$ 個選んで並べる。\n$$ _nP_r = \\frac{n!}{(n-r)!} $$"
                        },
                        {
                            "type": "definition",
                            "term": "組合せ ($ _nC_r $)",
                            "definition": "異なる $n$ 個から $r$ 個選ぶ（順序無視）。\n$$ _nC_r = \\frac{_nP_r}{r!} = \\frac{n!}{r!(n-r)!} $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 順列の基本 (Level 1)",
                            "problem": "7人の生徒から委員長、副委員長、書記を1人ずつ選ぶ選び方は何通りか。",
                            "solution_steps": [
                                "「委員長、副委員長、書記」と役職が違う＝順序（誰が何になるか）が区別される。",
                                "よって順列 (Permutation) を使う。",
                                "7人から3人選んで並べる。",
                                "$$ _7P_3 = 7 \\times 6 \\times 5 = 210 $$",
                                "答え: 210通り"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 組合せの基本 (Level 1)",
                            "problem": "7人の生徒から掃除当番を3人選ぶ選び方は何通りか。",
                            "solution_steps": [
                                "掃除当番という同じ役割＝順序は関係ない。",
                                "よって組合せ (Combination) を使う。",
                                "$$ _7C_3 = \\frac{7 \\times 6 \\times 5}{3 \\times 2 \\times 1} = 35 $$",
                                "答え: 35通り"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 確率",
            "sections": [
                {
                    "title": "確率の定義",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "確率は「起こりうる全ての場合の数」に対する「注目している事象の場合の数」の割合です。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: サイコロの確率 (Level 1)",
                            "problem": "大小2つのサイコロを同時に投げるとき、出る目の和が5になる確率を求めよ。",
                            "solution_steps": [
                                "1. 全事象（分母）を求める。",
                                "大は6通り、小は6通りなので、$6 \\times 6 = 36$ 通り。",
                                "2. 和が5になる場合（分子）を書き出す。",
                                "(大, 小) = (1, 4), (2, 3), (3, 2), (4, 1) の4通り。",
                                "3. 確率を計算。",
                                "$$ P = \\frac{4}{36} = \\frac{1}{9} $$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 余事象の確率 (Level 2)",
                            "problem": "コインを3回投げるとき、少なくとも1回は表が出る確率を求めよ。",
                            "solution_steps": [
                                "「少なくとも1回」という言葉が出たら「余事象（逆）」を疑う。",
                                "全体の確率 1 から、「すべて裏が出る確率」を引けばよい。",
                                "すべて裏が出る確率:",
                                "$$ (\\frac{1}{2}) \\times (\\frac{1}{2}) \\times (\\frac{1}{2}) = \\frac{1}{8} $$",
                                "求める確率は、",
                                "$$ 1 - \\frac{1}{8} = \\frac{7}{8} $$"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}