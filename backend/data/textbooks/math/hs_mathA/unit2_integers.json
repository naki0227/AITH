{
    "unit_id": "unit2_integers",
    "unit_title": "第2章 整数の性質",
    "order": 2,
    "chapters": [
        {
            "title": "1. 約数と倍数",
            "sections": [
                {
                    "title": "素因数分解",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "整数論は「数学の女王」とも呼ばれ、現代の暗号技術の基礎となっています。まずは整数を分解する技術を学びましょう。"
                        },
                        {
                            "type": "definition",
                            "term": "素数",
                            "definition": "1と自分自身以外に約数を持たない、2以上の自然数。\\n例: 2, 3, 5, 7, 11, 13, 17, 19, 23, ..."
                        },
                        {
                            "type": "definition",
                            "term": "素因数分解",
                            "definition": "自然数を素数の積として表すこと。\\n例: $60 = 2^2 \\times 3 \\times 5$"
                        },
                        {
                            "type": "point",
                            "title": "約数の個数と総和",
                            "content": "$n = p_1^{a_1} \\times p_2^{a_2} \\times ...$ のとき\\n- 約数の個数: $(a_1+1)(a_2+1)...$\\n- 約数の総和: $(1+p_1+...+p_1^{a_1})(1+p_2+...+p_2^{a_2})...$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 約数の個数",
                            "problem": "360の正の約数の個数を求めよ。",
                            "solution_steps": [
                                "$360 = 2^3 \\times 3^2 \\times 5^1$",
                                "約数の個数 = $(3+1)(2+1)(1+1) = 4 \\times 3 \\times 2 = 24$ 個"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "72を素因数分解せよ",
                                    "a": "$2^3 \\times 3^2$"
                                },
                                {
                                    "q": "100の正の約数の個数は？",
                                    "a": "9個"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "最大公約数と最小公倍数",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "最大公約数 (GCD)",
                            "definition": "2つ以上の整数に共通する約数のうち最大のもの。記号: $\\gcd(a, b)$"
                        },
                        {
                            "type": "definition",
                            "term": "最小公倍数 (LCM)",
                            "definition": "2つ以上の整数に共通する倍数のうち最小の正の数。記号: $\\text{lcm}(a, b)$"
                        },
                        {
                            "type": "point",
                            "title": "重要な性質",
                            "content": "2つの自然数 $a$, $b$ について\\n$$ a \\times b = \\gcd(a, b) \\times \\text{lcm}(a, b) $$"
                        },
                        {
                            "type": "point",
                            "title": "ユークリッドの互除法",
                            "content": "$\\gcd(a, b) = \\gcd(b, a \\mod b)$\\n余りが0になるまで繰り返し、最後の割る数が最大公約数"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 互除法",
                            "problem": "ユークリッドの互除法で861と231の最大公約数を求めよ。",
                            "solution_steps": [
                                "$861 = 231 \\times 3 + 168$",
                                "$231 = 168 \\times 1 + 63$",
                                "$168 = 63 \\times 2 + 42$",
                                "$63 = 42 \\times 1 + 21$",
                                "$42 = 21 \\times 2 + 0$",
                                "答え: $\\gcd(861, 231) = 21$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$\\gcd(48, 18)$ を求めよ",
                                    "a": "$6$"
                                },
                                {
                                    "q": "$\\gcd(24, 36) = 12$ のとき、$\\text{lcm}(24, 36)$ は？",
                                    "a": "$72$"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 整数の割り算",
            "sections": [
                {
                    "title": "剰余と合同式",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "合同式",
                            "definition": "$a$ と $b$ を $m$ で割った余りが等しいとき、\\n$a \\equiv b \\pmod{m}$ と書く"
                        },
                        {
                            "type": "point",
                            "title": "合同式の性質",
                            "content": "$a \\equiv b$, $c \\equiv d$ (mod $m$) のとき\\n1. $a + c \\equiv b + d$\\n2. $a - c \\equiv b - d$\\n3. $a \\times c \\equiv b \\times d$\\n4. $a^n \\equiv b^n$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 合同式",
                            "problem": "$7^{100}$ を5で割った余りを求めよ。",
                            "solution_steps": [
                                "$7 \\equiv 2 \\pmod{5}$",
                                "$7^2 \\equiv 4 \\pmod{5}$",
                                "$7^4 \\equiv 16 \\equiv 1 \\pmod{5}$",
                                "$100 = 4 \\times 25$ なので",
                                "$7^{100} = (7^4)^{25} \\equiv 1^{25} \\equiv 1 \\pmod{5}$",
                                "余りは $1$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$2^{10}$ を3で割った余りは？",
                                    "a": "$1$"
                                },
                                {
                                    "q": "$123456789$ を9で割った余りは？",
                                    "a": "$0$（各桁の和が45 = 9の倍数）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "3. 不定方程式",
            "sections": [
                {
                    "title": "一次不定方程式",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "整数解を持つ方程式を不定方程式といいます。一次不定方程式は整数論の重要なテーマです。"
                        },
                        {
                            "type": "point",
                            "title": "解の存在条件",
                            "content": "$ax + by = c$ が整数解を持つ条件：\\n$\\gcd(a, b)$ が $c$ を割り切る"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 一次不定方程式",
                            "problem": "$3x + 4y = 1$ の整数解をすべて求めよ。",
                            "solution_steps": [
                                "特殊解を1つ見つける: $x = -1$, $y = 1$",
                                "検算: $3(-1) + 4(1) = -3 + 4 = 1$ ✓",
                                "一般解: $x = -1 + 4t$, $y = 1 - 3t$ ($t$ は整数)"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: 応用問題",
                            "problem": "100円と150円の切手を使って、合計1000円ちょうどにする買い方をすべて求めよ。",
                            "solution_steps": [
                                "$100x + 150y = 1000$",
                                "$2x + 3y = 20$",
                                "$y = 0$: $x = 10$ → $(10, 0)$",
                                "$y = 2$: $x = 7$ → $(7, 2)$",
                                "$y = 4$: $x = 4$ → $(4, 4)$",
                                "$y = 6$: $x = 1$ → $(1, 6)$",
                                "答え: 4通り"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$5x + 7y = 1$ の整数解を1組求めよ",
                                    "a": "$x = 3$, $y = -2$"
                                },
                                {
                                    "q": "$6x + 9y = 5$ は整数解を持つか？",
                                    "a": "持たない（$\\gcd(6,9)=3$ が5を割り切らない）"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}