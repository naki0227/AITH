{
    "unit_id": "unit1_complex_numbers",
    "unit_title": "第1章 複素数と方程式",
    "order": 1,
    "chapters": [
        {
            "title": "1. 複素数",
            "sections": [
                {
                    "title": "虚数単位と複素数",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "2乗してマイナスになる数は実数の世界には存在しません。しかし、数学の世界を広げるために「2乗して-1になる数」を想像しました。それが虚数単位 $i$ です。"
                        },
                        {
                            "type": "definition",
                            "term": "虚数単位 i",
                            "definition": "$i^2 = -1$ を満たす数を**虚数単位**といいます。"
                        },
                        {
                            "type": "definition",
                            "term": "複素数",
                            "definition": "$a$, $b$ を実数とするとき、$a + bi$ の形の数を**複素数**といいます。\\n- $a$: **実部**（Real part）\\n- $b$: **虚部**（Imaginary part）\\n- $b \\neq 0$ のとき: **虚数**\\n- $a = 0$, $b \\neq 0$ のとき: **純虚数**"
                        },
                        {
                            "type": "point",
                            "title": "iの累乗",
                            "content": "$i^1 = i$\\n$i^2 = -1$\\n$i^3 = -i$\\n$i^4 = 1$\\n→ 4つ周期で繰り返す"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 複素数の計算",
                            "problem": "次を計算せよ。\\n(1) $(3+2i) + (4-5i)$\\n(2) $(2+3i)(4-i)$",
                            "solution_steps": [
                                "(1) 実部同士、虚部同士を計算",
                                "$(3+4) + (2-5)i = 7 - 3i$",
                                "(2) 普通に展開し、$i^2 = -1$ に置き換え",
                                "$8 - 2i + 12i - 3i^2$",
                                "$= 8 + 10i + 3 = 11 + 10i$"
                            ]
                        },
                        {
                            "type": "definition",
                            "term": "共役複素数",
                            "definition": "$z = a + bi$ に対し、$\\bar{z} = a - bi$ を**共役複素数**という。\\n$z \\cdot \\bar{z} = a^2 + b^2$（実数になる）"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 複素数の除法",
                            "problem": "$\\frac{3+2i}{1+i}$ を計算せよ。",
                            "solution_steps": [
                                "分母の共役複素数を分母分子にかける",
                                "$\\frac{(3+2i)(1-i)}{(1+i)(1-i)}$",
                                "分子: $3 - 3i + 2i - 2i^2 = 3 - i + 2 = 5 - i$",
                                "分母: $1 - i^2 = 1 + 1 = 2$",
                                "答え: $\\frac{5-i}{2} = \\frac{5}{2} - \\frac{1}{2}i$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$i^{100}$ の値は？",
                                    "a": "$1$（$100 = 4 \\times 25$）"
                                },
                                {
                                    "q": "$(1+i)^2$ を計算せよ",
                                    "a": "$2i$"
                                },
                                {
                                    "q": "$3+4i$ の共役複素数は？",
                                    "a": "$3-4i$"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 高次方程式",
            "sections": [
                {
                    "title": "二次方程式の解",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "判別式と解の種類",
                            "content": "$ax^2 + bx + c = 0$ の判別式 $D = b^2 - 4ac$\\n- $D > 0$: 異なる2つの実数解\\n- $D = 0$: 重解\\n- $D < 0$: **異なる2つの虚数解**（共役複素数）"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 虚数解",
                            "problem": "$x^2 + 2x + 5 = 0$ を解け。",
                            "solution_steps": [
                                "$D = 4 - 20 = -16 < 0$ なので虚数解",
                                "$x = \\frac{-2 \\pm \\sqrt{-16}}{2} = \\frac{-2 \\pm 4i}{2}$",
                                "答え: $x = -1 + 2i$, $x = -1 - 2i$"
                            ]
                        },
                        {
                            "type": "point",
                            "title": "解と係数の関係",
                            "content": "$ax^2 + bx + c = 0$ の2解を $\\alpha$, $\\beta$ とすると\\n- $\\alpha + \\beta = -\\frac{b}{a}$\\n- $\\alpha \\beta = \\frac{c}{a}$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 解と係数の関係",
                            "problem": "$x^2 - 5x + 3 = 0$ の2解を $\\alpha$, $\\beta$ とするとき、$\\alpha^2 + \\beta^2$ を求めよ。",
                            "solution_steps": [
                                "$\\alpha + \\beta = 5$, $\\alpha\\beta = 3$",
                                "$\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta$",
                                "$= 25 - 6 = 19$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$x^2 + 1 = 0$ の解は？",
                                    "a": "$x = \\pm i$"
                                },
                                {
                                    "q": "2解が $2+3i$ と $2-3i$ の二次方程式を1つ作れ",
                                    "a": "$x^2 - 4x + 13 = 0$"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}