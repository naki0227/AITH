    "unit_id": "unit1_complex_numbers",
    "unit_title": "第1章 複素数と方程式",
    "order": 1,
    "chapters": [
        {
            "title": "1. 複素数",
            "sections": [
                {
                    "title": "虚数単位 i",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "2乗してマイナスになる数は、実数の世界には存在しません。しかし、数学の世界を広げるために「2乗して-1になる数」を想像しました。それが虚数単位 $i$ です。"
                        },
                        {
                            "type": "definition",
                            "term": "虚数単位 i",
                            "definition": "$$ i^2 = -1 $$\n$a, b$ を実数とするとき、$a + bi$ の形の数を複素数という。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 複素数の計算 (Level 1)",
                            "problem": "次を計算せよ。\n(1) $(3+2i) + (4-5i)$\n(2) $(2+3i)(4-i)$",
                            "solution_steps": [
                                "(1) 実部同士、虚部同士を計算する。",
                                "$(3+4) + (2-5)i = 7 - 3i$",
                                "(2) 普通に展開し、$i^2 = -1$ に置き換える。",
                                "$8 - 2i + 12i - 3i^2$",
                                "$i^2 = -1$ なので $-3i^2 = +3$。",
                                "$8 + 10i + 3 = 11 + 10i$"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}