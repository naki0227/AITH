{
    "unit_id": "unit5_calculus_diff",
    "unit_title": "第5章 微分法",
    "order": 5,
    "chapters": [
        {
            "title": "1. 導関数",
            "sections": [
                {
                    "title": "微分の定義と計算",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "微分とは、グラフの「接線の傾き」を求めることです。これにより、関数の増減（上がっているか下がっているか）が分かります。"
                        },
                        {
                            "type": "point",
                            "title": "微分の公式",
                            "content": "$x^n$ を微分すると $nx^{n-1}$ になる。\n例: $(x^3)' = 3x^2$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 導関数を求める (Level 1)",
                            "problem": "$y = x^3 - 4x^2 + 5$ を微分せよ。",
                            "solution_steps": [
                                "項別に微分する。",
                                "$(x^3)' = 3x^2$",
                                "$(-4x^2)' = -4 \\cdot 2x = -8x$",
                                "$(5)' = 0$ （定数は消える）",
                                "答え: $y' = 3x^2 - 8x$"
                            ]
                        }
                    ]
                },
                {
                    "title": "接線",
                    "content_blocks": [
                        {
                            "type": "example_problem",
                            "title": "例題2: 接線の方程式 (Level 2)",
                            "problem": "曲線 $y=x^2$ 上の点 $(2, 4)$ における接線の方程式を求めよ。",
                            "solution_steps": [
                                "1. 導関数を求める。",
                                "$y' = 2x$",
                                "2. $x=2$ のときの傾きを求める。",
                                "$y'(2) = 2 \\times 2 = 4$ （これが傾き）",
                                "3. 点 $(2, 4)$ を通り傾き $4$ の直線を求める。",
                                "$y - 4 = 4(x - 2)$",
                                "$y = 4x - 8 + 4$",
                                "$y = 4x - 4$"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}