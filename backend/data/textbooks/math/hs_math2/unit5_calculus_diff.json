{
    "unit_id": "unit5_calculus_diff",
    "unit_title": "第5章 微分法",
    "order": 5,
    "chapters": [
        {
            "title": "1. 微分係数と導関数",
            "sections": [
                {
                    "title": "微分の概念",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "微分とは、関数の「瞬間の変化率」を求めることです。グラフでは「接線の傾き」に対応します。"
                        },
                        {
                            "type": "definition",
                            "term": "微分係数",
                            "definition": "関数 $f(x)$ の $x = a$ における微分係数:\\n$$ f'(a) = \\lim_{h \\to 0} \\frac{f(a+h) - f(a)}{h} $$"
                        },
                        {
                            "type": "definition",
                            "term": "導関数",
                            "definition": "$f'(x) = \\lim_{h \\to 0} \\frac{f(x+h) - f(x)}{h}$ を $f(x)$ の**導関数**という。"
                        },
                        {
                            "type": "point",
                            "title": "微分公式（基本）",
                            "content": "$(x^n)' = nx^{n-1}$\\n$(c)' = 0$ （定数）\\n$(cf(x))' = cf'(x)$\\n$(f(x) + g(x))' = f'(x) + g'(x)$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 導関数",
                            "problem": "$y = x^3 - 4x^2 + 5$ を微分せよ。",
                            "solution_steps": [
                                "$(x^3)' = 3x^2$",
                                "$(-4x^2)' = -8x$",
                                "$(5)' = 0$",
                                "答え: $y' = 3x^2 - 8x$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$y = x^4 - 3x^2 + 2$ を微分せよ",
                                    "a": "$4x^3 - 6x$"
                                },
                                {
                                    "q": "$y = 2x^3 + 5x$ を微分せよ",
                                    "a": "$6x^2 + 5$"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 接線と増減",
            "sections": [
                {
                    "title": "接線の方程式",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "接線の方程式",
                            "content": "曲線 $y = f(x)$ 上の点 $(a, f(a))$ における接線:\\n$$ y - f(a) = f'(a)(x - a) $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 接線",
                            "problem": "曲線 $y = x^2$ 上の点 $(2, 4)$ における接線の方程式を求めよ。",
                            "solution_steps": [
                                "$y' = 2x$",
                                "$f'(2) = 4$（傾き）",
                                "$y - 4 = 4(x - 2)$",
                                "$y = 4x - 4$"
                            ]
                        }
                    ]
                },
                {
                    "title": "関数の増減と極値",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "増減表の作り方",
                            "content": "1. $f'(x) = 0$ を解く\\n2. $f'(x)$ の符号を調べる\\n- $f'(x) > 0$: 増加\\n- $f'(x) < 0$: 減少\\n- 符号が変わる点が極値"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 極値",
                            "problem": "$f(x) = x^3 - 3x$ の極値を求めよ。",
                            "solution_steps": [
                                "$f'(x) = 3x^2 - 3 = 3(x+1)(x-1)$",
                                "$f'(x) = 0$ より $x = -1, 1$",
                                "増減表を書くと、$x = -1$ で極大、$x = 1$ で極小",
                                "極大値: $f(-1) = -1 + 3 = 2$",
                                "極小値: $f(1) = 1 - 3 = -2$"
                            ]
                        },
                        {
                            "type": "point",
                            "title": "最大・最小",
                            "content": "閉区間 $[a, b]$ での最大・最小は\\n- 極値\\n- 端点の値\\nを比較して決める"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 最大最小",
                            "problem": "$f(x) = x^3 - 3x$ の $-2 \\le x \\le 2$ での最大値・最小値を求めよ。",
                            "solution_steps": [
                                "極値: $f(-1) = 2$, $f(1) = -2$",
                                "端点: $f(-2) = -8 + 6 = -2$, $f(2) = 8 - 6 = 2$",
                                "最大値: 2（$x = -1$ と $x = 2$）",
                                "最小値: -2（$x = 1$ と $x = -2$）"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$f(x) = x^2 - 4x + 3$ の極値を求めよ",
                                    "a": "$x = 2$ で極小値 $-1$"
                                },
                                {
                                    "q": "$y = x^3$ は極値を持つか？",
                                    "a": "持たない（$y' = 3x^2 \\ge 0$ で常に増加）"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}