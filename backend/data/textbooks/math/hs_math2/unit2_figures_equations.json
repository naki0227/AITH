{
    "unit_id": "unit2_figures_equations",
    "unit_title": "第2章 図形と方程式",
    "order": 2,
    "chapters": [
        {
            "title": "1. 点と直線",
            "sections": [
                {
                    "title": "座標平面の基本公式",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "座標平面上の図形を、方程式で表現する方法を学びます。距離、分点、直線の方程式など、解析幾何学の基礎です。"
                        },
                        {
                            "type": "point",
                            "title": "2点間の距離",
                            "content": "$A(x_1, y_1)$, $B(x_2, y_2)$ 間の距離:\\n$$ AB = \\sqrt{(x_2-x_1)^2 + (y_2-y_1)^2} $$"
                        },
                        {
                            "type": "point",
                            "title": "内分点・外分点",
                            "content": "2点 $A(x_1, y_1)$, $B(x_2, y_2)$ を $m:n$ に内分する点:\\n$$ \\left(\\frac{nx_1 + mx_2}{m+n}, \\frac{ny_1 + my_2}{m+n}\\right) $$\\n中点は $m=n=1$ として\\n$$ \\left(\\frac{x_1 + x_2}{2}, \\frac{y_1 + y_2}{2}\\right) $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 内分点",
                            "problem": "A(1, 1), B(7, 4) を 2:1 に内分する点 P の座標を求めよ。",
                            "solution_steps": [
                                "$x = \\frac{1 \\times 1 + 2 \\times 7}{2+1} = \\frac{15}{3} = 5$",
                                "$y = \\frac{1 \\times 1 + 2 \\times 4}{2+1} = \\frac{9}{3} = 3$",
                                "答え: P(5, 3)"
                            ]
                        }
                    ]
                },
                {
                    "title": "直線の方程式",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "直線の方程式の形",
                            "content": "1. 傾き $m$、y切片 $n$: $y = mx + n$\\n2. 傾き $m$、点 $(x_1, y_1)$ を通る: $y - y_1 = m(x - x_1)$\\n3. 一般形: $ax + by + c = 0$"
                        },
                        {
                            "type": "point",
                            "title": "点と直線の距離",
                            "content": "点 $(x_0, y_0)$ と直線 $ax + by + c = 0$ の距離:\\n$$ d = \\frac{|ax_0 + by_0 + c|}{\\sqrt{a^2 + b^2}} $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 点と直線の距離",
                            "problem": "点 (3, 4) と直線 $3x + 4y - 5 = 0$ の距離を求めよ。",
                            "solution_steps": [
                                "$d = \\frac{|3(3) + 4(4) - 5|}{\\sqrt{9 + 16}}$",
                                "$= \\frac{|9 + 16 - 5|}{5} = \\frac{20}{5} = 4$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "原点と直線 $x + y - 2 = 0$ の距離は？",
                                    "a": "$\\sqrt{2}$"
                                },
                                {
                                    "q": "A(1,2), B(5,6) の中点の座標は？",
                                    "a": "(3, 4)"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 円",
            "sections": [
                {
                    "title": "円の方程式",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "円の方程式",
                            "content": "中心 $(a, b)$、半径 $r$ の円:\\n$$ (x-a)^2 + (y-b)^2 = r^2 $$\\n一般形: $x^2 + y^2 + Dx + Ey + F = 0$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 円の方程式",
                            "problem": "中心 $(-2, 3)$、半径 5 の円の方程式を求めよ。",
                            "solution_steps": [
                                "$(x-(-2))^2 + (y-3)^2 = 25$",
                                "$(x+2)^2 + (y-3)^2 = 25$"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 一般形から標準形へ",
                            "problem": "$x^2 + y^2 - 4x + 6y - 12 = 0$ の中心と半径を求めよ。",
                            "solution_steps": [
                                "平方完成する",
                                "$(x^2 - 4x) + (y^2 + 6y) = 12$",
                                "$(x-2)^2 - 4 + (y+3)^2 - 9 = 12$",
                                "$(x-2)^2 + (y+3)^2 = 25$",
                                "中心: (2, -3), 半径: 5"
                            ]
                        }
                    ]
                },
                {
                    "title": "円と直線",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "円と直線の位置関係",
                            "content": "円の中心と直線の距離を $d$、半径を $r$ とすると\\n- $d < r$: 2点で交わる\\n- $d = r$: 接する\\n- $d > r$: 共有点なし"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: 接線",
                            "problem": "円 $x^2 + y^2 = 5$ 上の点 (1, 2) における接線の方程式を求めよ。",
                            "solution_steps": [
                                "円 $x^2 + y^2 = r^2$ 上の点 $(x_1, y_1)$ における接線: $x_1 x + y_1 y = r^2$",
                                "$1 \\cdot x + 2 \\cdot y = 5$",
                                "答え: $x + 2y = 5$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "円 $x^2 + y^2 = 9$ の半径は？",
                                    "a": "3"
                                },
                                {
                                    "q": "中心が原点、点(3,4)を通る円の方程式は？",
                                    "a": "$x^2 + y^2 = 25$"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}