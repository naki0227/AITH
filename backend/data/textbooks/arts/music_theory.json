{
    "unit_id": "arts_music_theory",
    "unit_title": "音楽理論",
    "order": 2,
    "chapters": [
        {
            "title": "1. 楽典基礎",
            "sections": [
                {
                    "title": "音名と階名",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "音楽の基礎は「音」を正しく理解すること。音名と階名の違いを知ることで、楽譜が読めるようになります。"
                        },
                        {
                            "type": "definition",
                            "term": "音名",
                            "definition": "固定された音の高さ。調に関係なく決まっている。\\n**英語**: C, D, E, F, G, A, B\\n**日本語**: ハ, ニ, ホ, ヘ, ト, イ, ロ"
                        },
                        {
                            "type": "definition",
                            "term": "階名",
                            "definition": "調によって変わる役割。主音を「ド」とする。\\n**移動ド**: ド, レ, ミ, ファ, ソ, ラ, シ"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 音階",
                            "problem": "ト長調(G Major)の「ド」の音は、実音（音名）で言うと何か。",
                            "solution_steps": [
                                "ト長調は「ト(G)」を主音とする調",
                                "答え: **G（ソの音）**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "ヘ長調(F Major)の「ド」は実音で何？",
                                    "a": "F"
                                },
                                {
                                    "q": "ハ長調の調号（#や♭）の数は？",
                                    "a": "0（なし）"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "音程",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "音程",
                            "definition": "2つの音の高さの差。度数で表す。\\n**1度**: 同じ音\\n**3度**: ドとミ\\n**5度**: ドとソ\\n**8度（オクターブ）**: ドと高いド"
                        },
                        {
                            "type": "point",
                            "title": "協和音程と不協和音程",
                            "content": "**完全協和音程**: 1度, 5度, 8度\\n**不完全協和音程**: 3度, 6度\\n**不協和音程**: 2度, 7度"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 音程",
                            "problem": "ドとソの音程は何度か。",
                            "solution_steps": [
                                "ド→レ→ミ→ファ→ソ と数える",
                                "答え: **5度（完全5度）**"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 和声",
            "sections": [
                {
                    "title": "コード（和音）",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "三和音",
                            "definition": "3つの音からなる和音。\\n**メジャー(長三和音)**: ド+ミ+ソ\\n**マイナー(短三和音)**: ド+ミ♭+ソ"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: コード",
                            "problem": "Cメジャーコードを構成する音は何か。",
                            "solution_steps": [
                                "Cを根音とする長三和音",
                                "答え: **C, E, G（ド, ミ, ソ）**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "Am（Aマイナー）コードの構成音は？",
                                    "a": "A, C, E（ラ, ド, ミ）"
                                },
                                {
                                    "q": "Gメジャーコードの構成音は？",
                                    "a": "G, B, D"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}