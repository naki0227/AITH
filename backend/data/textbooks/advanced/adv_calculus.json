{
    "unit_id": "adv_calculus",
    "unit_title": "大学教養 微分積分",
    "order": 1,
    "chapters": [
        {
            "title": "1. 偏微分",
            "sections": [
                {
                    "title": "偏導関数",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "1変数の微分では「曲線の傾き」を求めましたが、多変数の偏微分では「曲面上の、ある方向への傾き」を求めます。"
                        },
                        {
                            "type": "definition",
                            "term": "偏微分",
                            "definition": "$z = f(x, y)$ において、$y$ を定数とみなして $x$ で微分したものを $x$ に関する偏導関数といい、$\\frac{\\partial z}{\\partial x}$ や $f_x$ と書く。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 偏微分の計算",
                            "problem": "$f(x, y) = x^2 y + y^3$ の偏導関数 $f_x, f_y$ を求めよ。",
                            "solution_steps": [
                                "$f_x$: $y$ を定数扱い → $(x^2 y)' = 2xy$, $(y^3)' = 0$",
                                "∴ $f_x = 2xy$",
                                "$f_y$: $x$ を定数扱い → $(x^2 y)' = x^2$, $(y^3)' = 3y^2$",
                                "∴ $f_y = x^2 + 3y^2$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$f = x^3 + xy$ の $f_x$ は？",
                                    "a": "$3x^2 + y$"
                                },
                                {
                                    "q": "$f = e^{xy}$ の $f_x$ は？",
                                    "a": "$ye^{xy}$"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 重積分",
            "sections": [
                {
                    "title": "二重積分",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "1変数の積分は「曲線の下の面積」でしたが、2変数の重積分は「曲面の下の体積」を求める操作です。"
                        },
                        {
                            "type": "definition",
                            "term": "累次積分",
                            "definition": "$\\iint_D f(x, y) dxdy = \\int_a^b \\left( \\int_{g_1(x)}^{g_2(x)} f(x, y) dy \\right) dx$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 二重積分",
                            "problem": "領域 $D: 0 \\le x \\le 1, 0 \\le y \\le 2$ で $\\iint_D xy dxdy$ を求めよ。",
                            "solution_steps": [
                                "$\\int_0^1 x dx \\times \\int_0^2 y dy$",
                                "$= \\frac{1}{2} \\times 2 = 1$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "$\\int_0^1 \\int_0^1 (x+y) dxdy$ は？",
                                    "a": "$1$"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}