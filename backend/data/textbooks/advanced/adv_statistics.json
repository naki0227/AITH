            "title": "1. 記述統計",
            "sections": [
                {
                    "title": "代表値と散布度",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "代表値",
                            "content": "**平均値**: データの総和 ÷ 個数\\n**中央値**: データを並べた真ん中\\n**最頻値**: 最も頻度が高い値"
                        },
                        {
                            "type": "definition",
                            "term": "分散と標準偏差",
                            "definition": "分散: $\\sigma^2 = \\frac{1}{n}\\sum(x_i - \\bar{x})^2$\\n標準偏差: $\\sigma = \\sqrt{\\sigma^2}$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 平均と分散",
                            "problem": "データ 2, 4, 4, 4, 6 の平均と分散を求めよ。",
                            "solution_steps": [
                                "平均: $(2+4+4+4+6)/5 = 4$",
                                "分散: $\\frac{(2-4)^2 + 0 + 0 + 0 + (6-4)^2}{5} = \\frac{8}{5} = 1.6$"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 推測統計",
            "sections": [
                {
                    "title": "仮説検定",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "仮説検定の流れ",
                            "content": "1. 帰無仮説 $H_0$ と対立仮説 $H_1$ を設定\\n2. 有意水準 $\\alpha$ を決める（通常5%）\\n3. 検定統計量を計算\\n4. p値 < $\\alpha$ なら $H_0$ を棄却"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 仮説検定",
                            "problem": "有意水準5%で検定を行い、p値が0.03だった。帰無仮説は棄却されるか。",
                            "solution_steps": [
                                "$p = 0.03 < 0.05 = \\alpha$",
                                "答え: **棄却される**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "p値が0.08で有意水準5%のとき、帰無仮説は？",
                                    "a": "棄却されない"
                                },
                                {
                                    "q": "第一種の過誤とは？",
                                    "a": "帰無仮説が正しいのに棄却してしまう誤り"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
