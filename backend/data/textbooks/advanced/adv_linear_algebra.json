{
    "unit_id": "adv_linear_algebra",
    "unit_title": "大学教養 線形代数",
    "order": 2,
    "chapters": [
        {
            "title": "1. 行列",
            "sections": [
                {
                    "title": "行列の基本",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "行列は数を長方形に並べたもの。連立方程式の解法やデータ分析、機械学習など、現代の数学・工学に欠かせないツールです。"
                        },
                        {
                            "type": "definition",
                            "term": "行列の積",
                            "definition": "$m \\times n$ 行列 $A$ と $n \\times p$ 行列 $B$ の積 $AB$ は $m \\times p$ 行列。\\n$(AB)_{ij} = \\sum_{k=1}^{n} a_{ik}b_{kj}$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 行列の積",
                            "problem": "$A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$, $B = \\begin{pmatrix} 5 & 6 \\\\ 7 & 8 \\end{pmatrix}$ のとき $AB$ を求めよ。",
                            "solution_steps": [
                                "$(1,1)$成分: $1 \\times 5 + 2 \\times 7 = 19$",
                                "$(1,2)$成分: $1 \\times 6 + 2 \\times 8 = 22$",
                                "$(2,1)$成分: $3 \\times 5 + 4 \\times 7 = 43$",
                                "$(2,2)$成分: $3 \\times 6 + 4 \\times 8 = 50$",
                                "$AB = \\begin{pmatrix} 19 & 22 \\\\ 43 & 50 \\end{pmatrix}$"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 行列式と固有値",
            "sections": [
                {
                    "title": "行列式",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "2次行列式",
                            "definition": "$\\det \\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix} = ad - bc$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 行列式",
                            "problem": "$\\begin{pmatrix} 3 & 1 \\\\ 2 & 4 \\end{pmatrix}$ の行列式を求めよ。",
                            "solution_steps": [
                                "$3 \\times 4 - 1 \\times 2 = 12 - 2 = 10$"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "単位行列の行列式は？",
                                    "a": "$1$"
                                },
                                {
                                    "q": "行列式が0のとき、その行列は何と呼ばれる？",
                                    "a": "特異行列（逆行列が存在しない）"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}