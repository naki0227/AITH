{
    "unit_id": "adv_linear_algebra",
    "unit_title": "大学教養 線形代数",
    "order": 2,
    "chapters": [
        {
            "title": "1. 行列",
            "sections": [
                {
                    "title": "行列の積",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "行列の掛け算は、単なる数字の掛け算とは違います。「行」と「列」を組み合わせる特殊なルールによって、一次変換や連立方程式の記述が可能になります。"
                        },
                        {
                            "type": "point",
                            "title": "積のルール",
                            "content": "$(i, k)$ 成分は、左の行列の「第i行」と右の行列の「第k列」の内積になる。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 行列の積 (Level 1)",
                            "problem": "$A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}, B = \\begin{pmatrix} 2 & 0 \\\\ 1 & -1 \\end{pmatrix}$ のとき、$AB$ を計算せよ。",
                            "solution_steps": [
                                "1行1列: $1\\cdot2 + 2\\cdot1 = 4$",
                                "1行2列: $1\\cdot0 + 2\\cdot(-1) = -2$",
                                "2行1列: $3\\cdot2 + 4\\cdot1 = 10$",
                                "2行2列: $3\\cdot0 + 4\\cdot(-1) = -4$",
                                "答え: $\\begin{pmatrix} 4 & -2 \\\\ 10 & -4 \\end{pmatrix}$"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 固有値",
            "sections": [
                {
                    "title": "固有値と固有ベクトル",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "固有値 (Eigenvalue)",
                            "definition": "$A\\vec{x} = \\lambda\\vec{x}$ ($\\vec{x} \\neq \\vec{0}$) を満たす $\\lambda$ を固有値、$\\vec{x}$ を固有ベクトルという。行列による変換で「向きが変わらないベクトル」のこと。"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 固有値の計算 (Level 2)",
                            "problem": "$A = \\begin{pmatrix} 2 & 1 \\\\ 1 & 2 \\end{pmatrix}$ の固有値を求めよ。",
                            "solution_steps": [
                                "固有方程式 $|A - \\lambda E| = 0$ を解く。",
                                "$\\begin{vmatrix} 2-\\lambda & 1 \\\\ 1 & 2-\\lambda \\end{vmatrix} = 0$",
                                "$(2-\\lambda)^2 - 1 = 0$",
                                "$\\lambda^2 - 4\\lambda + 3 = 0$",
                                "$(\\lambda - 1)(\\lambda - 3) = 0$",
                                "答え: $\\lambda = 1, 3$"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}