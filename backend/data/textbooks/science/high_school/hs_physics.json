{
    "unit_id": "science_hs_physics",
    "unit_title": "高校物理",
    "order": 1,
    "chapters": [
        {
            "title": "1. 力学",
            "sections": [
                {
                    "title": "運動の法則",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "「なぜ物は動くのか？」この根源的な問いに答えるのがニュートンの運動の法則です。これを理解すれば、ロケットの軌道からボールの動きまで全て計算できます。"
                        },
                        {
                            "type": "point",
                            "title": "運動の3法則",
                            "content": "**第1法則（慣性の法則）**\\n力が働かなければ、物体は静止し続けるか等速直線運動を続ける。\\n\\n**第2法則（運動方程式）**\\n$ma = F$\\n\\n**第3法則（作用反作用の法則）**\\n物体Aが物体Bに力を及ぼすと、BもAに大きさが等しく向きが反対の力を及ぼす。"
                        },
                        {
                            "type": "definition",
                            "term": "運動方程式",
                            "definition": "$$ ma = F $$\\n$m$: 質量 [kg], $a$: 加速度 [m/s²], $F$: 力 [N]\\n「力は質量と加速度の積に等しい」"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 運動方程式",
                            "problem": "質量 2.0kg の物体に 10N の力を加えたとき、生じる加速度の大きさはいくらか。",
                            "solution_steps": [
                                "運動方程式 $ma = F$ に代入",
                                "$2.0 \\times a = 10$",
                                "$a = 5.0$ m/s²"
                            ]
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 摩擦力",
                            "problem": "水平面上の質量 5kg の物体に水平方向に 20N の力を加えた。動摩擦係数が 0.2 のとき、加速度を求めよ。$g = 10$ m/s²。",
                            "solution_steps": [
                                "垂直抗力 $N = mg = 50$ N",
                                "動摩擦力 $f = \\mu N = 0.2 \\times 50 = 10$ N",
                                "合力 $F = 20 - 10 = 10$ N",
                                "$a = F/m = 10/5 = 2$ m/s²"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "3kgの物体に6Nの力を加えると加速度は？",
                                    "a": "2 m/s²"
                                },
                                {
                                    "q": "加速度2m/s²で質量4kgの物体を動かすのに必要な力は？",
                                    "a": "8 N"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "エネルギー保存則",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "運動エネルギーと位置エネルギー",
                            "definition": "**運動エネルギー**: $K = \\frac{1}{2}mv^2$\\n**重力による位置エネルギー**: $U = mgh$"
                        },
                        {
                            "type": "point",
                            "title": "力学的エネルギー保存則",
                            "content": "保存力のみが働くとき（摩擦がない）、運動エネルギーと位置エネルギーの和は一定。\\n$$ \\frac{1}{2}mv_1^2 + mgh_1 = \\frac{1}{2}mv_2^2 + mgh_2 $$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 自由落下",
                            "problem": "高さ 10m から物体を自由落下させた。地面に到達する直前の速さを求めよ。$g = 10$ m/s²。",
                            "solution_steps": [
                                "エネルギー保存則: $mgh = \\frac{1}{2}mv^2$",
                                "$gh = \\frac{1}{2}v^2$",
                                "$v^2 = 2gh = 2 \\times 10 \\times 10 = 200$",
                                "$v = \\sqrt{200} \\approx 14.1$ m/s"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "高さ5mから落下した物体の地面での速さは？($g=10$)",
                                    "a": "10 m/s"
                                },
                                {
                                    "q": "10m/sで打ち上げた物体の最高点の高さは？",
                                    "a": "5 m"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 波動",
            "sections": [
                {
                    "title": "波の基本",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "波の基本量",
                            "definition": "**波長**: $\\lambda$ [m]\\n**振動数（周波数）**: $f$ [Hz]\\n**周期**: $T = 1/f$ [s]\\n**波の速さ**: $v = f\\lambda$"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題4: 波の速さ",
                            "problem": "波長2m、振動数5Hzの波の速さを求めよ。",
                            "solution_steps": [
                                "$v = f\\lambda = 5 \\times 2 = 10$ m/s"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "3. 電磁気",
            "sections": [
                {
                    "title": "電気回路",
                    "content_blocks": [
                        {
                            "type": "definition",
                            "term": "オームの法則",
                            "definition": "$V = RI$\\n$V$: 電圧 [V], $R$: 抵抗 [Ω], $I$: 電流 [A]"
                        },
                        {
                            "type": "definition",
                            "term": "クーロンの法則",
                            "definition": "$$ F = k \\frac{q_1 q_2}{r^2} $$\\n$k$: 比例定数、$q$: 電気量、$r$: 距離"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題5: オームの法則",
                            "problem": "10Ωの抵抗に2Aの電流が流れているとき、抵抗にかかる電圧は？",
                            "solution_steps": [
                                "$V = RI = 10 \\times 2 = 20$ V"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "100Vの電源に20Ωの抵抗を繋いだときの電流は？",
                                    "a": "5 A"
                                },
                                {
                                    "q": "抵抗3Ωと6Ωを並列に繋いだときの合成抵抗は？",
                                    "a": "2 Ω"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}