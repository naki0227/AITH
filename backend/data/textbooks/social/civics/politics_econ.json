    "order": 3,
    "chapters": [
        {
            "title": "1. 現代社会と政治",
            "sections": [
                {
                    "title": "日本国憲法",
                    "content_blocks": [
                        {
                            "type": "introduction",
                            "text": "日本国憲法は日本の最高法規です。三大原理（国民主権、基本的人権の尊重、平和主義）を理解することが公民の第一歩です。"
                        },
                        {
                            "type": "point",
                            "title": "憲法の三大原理",
                            "content": "**国民主権**: 国の政治の最終決定権は国民にある\\n**基本的人権の尊重**: 生まれながらの権利を保障\\n**平和主義**: 戦争放棄（第9条）"
                        },
                        {
                            "type": "definition",
                            "term": "基本的人権",
                            "definition": "**自由権**: 精神・身体・経済活動の自由\\n**平等権**: 法の下の平等（14条）\\n**社会権**: 生存権（25条）、教育を受ける権利\\n**参政権**: 選挙権、被選挙権"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題1: 憲法条文",
                            "problem": "「すべて国民は、健康で文化的な最低限度の生活を営む権利を有する」は何条か。",
                            "solution_steps": [
                                "生存権を定めた条文",
                                "答え: **憲法第25条**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "検閲の禁止を定めているのは何条か？",
                                    "a": "憲法第21条"
                                },
                                {
                                    "q": "「法の下の平等」は何条？",
                                    "a": "憲法第14条"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "三権分立",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "権力の分立",
                            "content": "**立法権**: 国会（法律を作る）\\n**行政権**: 内閣（法律を実行する）\\n**司法権**: 裁判所（法律に基づいて裁く）\\n→ 相互にチェックし合い、権力の集中を防ぐ"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題2: 三権分立",
                            "problem": "内閣不信任決議を可決できるのはどこか。",
                            "solution_steps": [
                                "国会（衆議院）が内閣をチェック",
                                "答え: **衆議院**"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "title": "2. 経済の仕組み",
            "sections": [
                {
                    "title": "市場経済",
                    "content_blocks": [
                        {
                            "type": "point",
                            "title": "需要と供給",
                            "content": "価格は需要（買いたい量）と供給（売りたい量）のバランスで決まる。\\nアダム・スミスはこれを「神の見えざる手」と呼んだ。"
                        },
                        {
                            "type": "definition",
                            "term": "インフレーションとデフレーション",
                            "definition": "**インフレ**: 物価が上昇し続ける → 通貨価値が下がる\\n**デフレ**: 物価が下落し続ける → 通貨価値が上がる"
                        },
                        {
                            "type": "example_problem",
                            "title": "例題3: 経済用語",
                            "problem": "インフレーションの時、通貨の価値はどうなるか。",
                            "solution_steps": [
                                "インフレ = モノの値段が上がる",
                                "同じ金額で買えるモノが減る",
                                "答え: **通貨の価値は下がる**"
                            ]
                        },
                        {
                            "type": "exercise",
                            "problems": [
                                {
                                    "q": "「神の見えざる手」を唱えた経済学者は？",
                                    "a": "アダム・スミス"
                                },
                                {
                                    "q": "日本の中央銀行は？",
                                    "a": "日本銀行"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
